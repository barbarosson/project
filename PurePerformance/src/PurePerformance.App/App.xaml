<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PurePerformance.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Do not set RequestedTheme here. ApplicationTheme only allows Light|Dark
         (WMC0055 if Default). User Light/Dark/System is applied on MainWindow
         RootGrid via ElementTheme (see ThemeService). -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

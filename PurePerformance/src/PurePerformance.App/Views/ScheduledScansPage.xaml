<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="PurePerformance.Views.ScheduledScansPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      NavigationCacheMode="Disabled">
  <ScrollViewer Padding="24">
    <StackPanel Spacing="16" MaxWidth="720">
      <TextBlock Text="Scheduled scans" Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
      <TextBlock TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Text="Daily or weekly summary while the app is open. Exports a local Markdown report (print to PDF from any viewer). Email delivery is a stub." />
      <ToggleSwitch Header="Enable schedule" IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" />
      <StackPanel Orientation="Horizontal" Spacing="16">
        <RadioButton Content="Daily" IsChecked="{x:Bind ViewModel.IsDaily, Mode=TwoWay}" GroupName="Cadence" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        <RadioButton Content="Weekly" IsChecked="{x:Bind ViewModel.IsWeekly, Mode=TwoWay}" GroupName="Cadence" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
      </StackPanel>
      <NumberBox Header="Preferred local hour (0–23)" Value="{x:Bind ViewModel.PreferredHour, Mode=TwoWay}" Minimum="0" Maximum="23" SpinButtonPlacementMode="Inline" />
      <ToggleSwitch Header="Email stub (no mail sent yet)" IsOn="{x:Bind ViewModel.EmailStubEnabled, Mode=TwoWay}" />
      <TextBox Header="Email address (stub only)" Text="{x:Bind ViewModel.EmailStubAddress, Mode=TwoWay}" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="Save schedule" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" />
        <Button Content="Run summary now" Command="{x:Bind ViewModel.RunNowCommand}" IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}" />
        <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
      </StackPanel>
      <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
      <TextBox IsReadOnly="True" Text="{x:Bind ViewModel.LastReportPath, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
    </StackPanel>
  </ScrollViewer>
</Page>

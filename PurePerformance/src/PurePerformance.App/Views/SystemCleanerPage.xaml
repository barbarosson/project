<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PurePerformance.Views.SystemCleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PurePerformance.ViewModels"
    NavigationCacheMode="Enabled">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock Text="System Cleaner"
                       Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Cleans only the folders listed below (user TEMP, Windows TEMP, Prefetch, browser caches). This is not a registry cleaner — no registry keys are deleted."
                       TextWrapping="WrapWholeWords"
                       Opacity="0.9" />
            <InfoBar IsOpen="True"
                     IsClosable="False"
                     Severity="Warning"
                     Title="What gets cleaned"
                     Message="Locked files are skipped. Close browsers before cache cleanup. Prefetch / Windows TEMP may need admin." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button Content="Refresh sizes"
                    Command="{x:Bind ViewModel.RefreshCommand}" />
            <Button Content="Clean selected"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.CleanCommand}" />
            <Button Content="Relaunch as admin"
                    Command="{x:Bind ViewModel.RelaunchElevatedCommand}" />
            <ProgressRing Width="24" Height="24"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>

        <ListView Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.Targets, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:CleanupTargetItem">
                    <Grid Padding="8,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind WhatItCleans}" TextWrapping="WrapWholeWords" Opacity="0.85" />
                            <TextBlock Text="{x:Bind PathsLabel}" FontFamily="Consolas" FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind AdminHint}" FontSize="12" Opacity="0.7" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind SizeLabel}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Top" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="WrapWholeWords" />
            <TextBlock Text="{x:Bind ViewModel.ResultDetails, Mode=OneWay}"
                       TextWrapping="WrapWholeWords"
                       FontSize="12"
                       Opacity="0.8" />
            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" Title="Cleanup" />
        </StackPanel>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PurePerformance.Views.ProUnlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="640">
            <TextBlock Text="{x:Bind ViewModel.Headline, Mode=OneWay}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       TextWrapping="WrapWholeWords"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.HonestCopy}"
                       TextWrapping="WrapWholeWords"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       Opacity="0.92" />

            <InfoBar IsOpen="True"
                     IsClosable="False"
                     Severity="Informational"
                     Title="What you already have"
                     Message="Crash Analyzer, Dashboard, Startup Optimizer, System Cleaner, and Memory Optimizer work on the free tier — no purchase required." />

            <InfoBar IsOpen="True"
                     IsClosable="False"
                     Severity="Informational"
                     Title="License"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <InfoBar x:Name="DevBypassBar"
                     IsClosable="False"
                     Severity="Warning"
                     Title="Local / dev bypass"
                     Message="If Pro is unlocked here in Debug, that is a development bypass — not a Store receipt." />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Unlock Pro…"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.PurchaseCommand}"
                        IsEnabled="{x:Bind ViewModel.CanAct, Mode=OneWay}" />
                <Button Content="Refresh license"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        IsEnabled="{x:Bind ViewModel.CanAct, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <ProgressRing Width="24" Height="24"
                              IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>

            <TextBlock Text="After unlocking, open the Pro pane again from the left navigation."
                       TextWrapping="WrapWholeWords"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</Page>

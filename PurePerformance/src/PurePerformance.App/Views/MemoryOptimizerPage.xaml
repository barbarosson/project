<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PurePerformance.Views.MemoryOptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="720">
            <TextBlock Text="Memory Optimizer"
                       Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       TextWrapping="WrapWholeWords"
                       Opacity="0.9" />

            <InfoBar IsOpen="True"
                     IsClosable="False"
                     Severity="Informational"
                     Title="How this works"
                     Message="Uses EmptyWorkingSet on processes Pure Performance can open. Critical system processes are skipped. Trimmed memory may be reclaimed by apps when you use them again." />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Total" Opacity="0.7" />
                        <TextBlock Text="{x:Bind ViewModel.TotalLabel, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="In use" Opacity="0.7" />
                        <TextBlock Text="{x:Bind ViewModel.InUseLabel, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Available" Opacity="0.7" />
                        <TextBlock Text="{x:Bind ViewModel.AvailableLabel, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <ProgressBar Value="{x:Bind ViewModel.InUsePercent, Mode=OneWay}" Maximum="100" Height="8" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Refresh"
                        Command="{x:Bind ViewModel.RefreshCommand}" />
                <Button Content="Trim working sets"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.OptimizeCommand}" />
                <ProgressRing Width="24" Height="24"
                              IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.LastResult, Mode=OneWay}"
                       TextWrapping="WrapWholeWords" />
            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" Title="Memory" />
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PurePerformance.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="720">
            <TextBlock Text="{x:Bind ViewModel.ProductName}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       FontSize="36"
                       FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind ViewModel.Tagline}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Opacity="0.9" />
            <TextBlock Text="{x:Bind ViewModel.PositioningCopy}"
                       TextWrapping="WrapWholeWords"
                       Style="{StaticResource BodyTextBlockStyle}" />
            <InfoBar IsOpen="True"
                     IsClosable="False"
                     Severity="Informational"
                     Title="Permissions"
                     Message="{x:Bind ViewModel.ElevationStatus}" />
            <TextBlock Text="Open Crash Analyzer from the left nav to scan Event Viewer for the last 24 or 72 hours."
                       TextWrapping="WrapWholeWords"
                       Opacity="0.8" />
        </StackPanel>
    </ScrollViewer>
</Page>

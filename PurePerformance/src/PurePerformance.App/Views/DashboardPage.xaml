<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PurePerformance.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PurePerformance.Models"
    NavigationCacheMode="Disabled">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="960">
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.ProductName}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           FontSize="34"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.Tagline}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Opacity="0.92" />
                <InfoBar IsOpen="True"
                         IsClosable="False"
                         Severity="Informational"
                         Title="Permissions"
                         Message="{x:Bind ViewModel.ElevationStatus, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Start monitoring"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.StartMonitoringCommand}"
                        IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" />
                <Button Content="Stop"
                        Command="{x:Bind ViewModel.StopMonitoringCommand}"
                        IsEnabled="{x:Bind ViewModel.IsMonitoring, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Opacity="0.8" />
            </StackPanel>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="CPU" Opacity="0.7" />
                        <TextBlock Text="{x:Bind ViewModel.CpuLabel, Mode=OneWay}"
                                   FontSize="28" FontWeight="SemiBold" />
                        <ProgressBar Value="{x:Bind ViewModel.CpuPercent, Mode=OneWay}" Maximum="100" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Memory" Opacity="0.7" />
                        <TextBlock Text="{x:Bind ViewModel.MemoryLabel, Mode=OneWay}"
                                   FontSize="28" FontWeight="SemiBold" />
                        <ProgressBar Value="{x:Bind ViewModel.MemoryPercent, Mode=OneWay}" Maximum="100" />
                        <TextBlock Text="{x:Bind ViewModel.MemoryDetail, Mode=OneWay}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Disk" Opacity="0.7" />
                        <TextBlock Text="{x:Bind ViewModel.DiskLabel, Mode=OneWay}"
                                   FontSize="28" FontWeight="SemiBold" />
                        <ProgressBar Value="{x:Bind ViewModel.DiskPercent, Mode=OneWay}" Maximum="100" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="GPU" Opacity="0.7" />
                        <TextBlock Text="{x:Bind ViewModel.GpuLabel, Mode=OneWay}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Spacing="8">
                <TextBlock Text="High-usage processes"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <ListView ItemsSource="{x:Bind ViewModel.TopProcesses, Mode=OneWay}"
                          MinHeight="200">
                    <ListView.Header>
                        <Grid Padding="12,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Process" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Grid.Column="1" Text="CPU" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Grid.Column="2" Text="Memory" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Grid.Column="3" Text="PID" FontWeight="SemiBold" Opacity="0.7" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ProcessUsage">
                            <Grid Padding="4,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" TextWrapping="NoWrap" />
                                <TextBlock Grid.Column="1" Text="{x:Bind CpuLabel}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind MemoryLabel}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind ProcessId}" Opacity="0.7" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

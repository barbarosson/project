<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PurePerformance.Views.StartupOptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <StackPanel Padding="24" Spacing="12" MaxWidth="720">
        <TextBlock Text="Startup Optimizer"
                   Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="{x:Bind ViewModel.StatusMessage}"
                   TextWrapping="WrapWholeWords"
                   Style="{StaticResource BodyTextBlockStyle}" />
        <InfoBar IsOpen="True"
                 IsClosable="False"
                 Severity="Informational"
                 Title="Coming soon"
                 Message="This pane is a stub. The next module will list startup entries and let you disable them with clear confirmation — no registry cleaner." />
    </StackPanel>
</Page>

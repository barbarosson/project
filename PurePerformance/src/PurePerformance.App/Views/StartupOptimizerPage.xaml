<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PurePerformance.Views.StartupOptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PurePerformance.ViewModels"
    NavigationCacheMode="Enabled">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock Text="Startup Optimizer"
                       Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Shows Registry Run (HKCU / HKLM) and Startup-folder shortcuts. Disable moves an entry to a Pure Performance backup so you can re-enable it — values are not permanently deleted."
                       TextWrapping="WrapWholeWords"
                       Opacity="0.9" />
            <InfoBar IsOpen="True"
                     IsClosable="False"
                     Severity="Informational"
                     Title="Store-safe behavior"
                     Message="Not a registry cleaner. All-users (HKLM / Common Startup) changes need UAC — use Relaunch as admin only when required." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button Content="Refresh"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" />
            <Button Content="Relaunch as admin"
                    Command="{x:Bind ViewModel.RelaunchElevatedCommand}" />
            <TextBlock VerticalAlignment="Center" Opacity="0.8">
                <Run Text="Elevation: " />
                <Run Text="{x:Bind ViewModel.IsElevated, Mode=OneWay}" />
            </TextBlock>
            <ProgressRing Width="24" Height="24"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>

        <ListView Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:StartupEntryItem">
                    <Grid Padding="8,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind LocationLabel}" FontSize="12" Opacity="0.7" />
                            <TextBlock Text="{x:Bind Command}" FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind LastMessage, Mode=OneWay}"
                                   TextWrapping="WrapWholeWords"
                                   Opacity="0.8"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                       Opacity="0.7"
                                       FontSize="12"
                                       HorizontalAlignment="Right" />
                            <Button Content="{x:Bind ActionLabel, Mode=OneWay}"
                                    Tag="{x:Bind}"
                                    MinWidth="100"
                                    Click="ToggleButton_Click" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="WrapWholeWords" />
            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" Title="Startup change" />
        </StackPanel>
    </Grid>
</Page>

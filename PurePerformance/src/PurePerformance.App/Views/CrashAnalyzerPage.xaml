<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PurePerformance.Views.CrashAnalyzerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PurePerformance.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock Text="Crash Analyzer"
                       Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Reads Application and System Event Viewer logs for kernel-power events, app hangs, disk errors, and BSODs. Results include plain-English explanations — nothing is deleted."
                       TextWrapping="WrapWholeWords"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Opacity="0.9" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="Lookback" Opacity="0.8" FontSize="12" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton Content="Last 24 hours"
                                 IsChecked="{x:Bind ViewModel.IsLookback24, Mode=TwoWay}"
                                 GroupName="Lookback" />
                    <RadioButton Content="Last 72 hours"
                                 IsChecked="{x:Bind ViewModel.IsLookback72, Mode=TwoWay}"
                                 GroupName="Lookback" />
                </StackPanel>
            </StackPanel>

            <Button Content="Scan Event Logs"
                    Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.ScanCommand}"
                    IsEnabled="{x:Bind ViewModel.CanScan, Mode=OneWay}" />

            <Button Content="Cancel"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.CancelScanCommand}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <ProgressRing Width="28"
                          Height="28"
                          VerticalAlignment="Bottom"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView ItemsSource="{x:Bind ViewModel.Findings, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedFinding, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:CrashEvent">
                        <StackPanel Spacing="2" Padding="4,8">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="{x:Bind SummaryLine}" Opacity="0.7" FontSize="12" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Details"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="ExplanationText"
                               TextWrapping="WrapWholeWords" />
                    <TextBlock Text="Recommended fix"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="FixText"
                               TextWrapping="WrapWholeWords" />
                    <TextBlock Text="Raw message (excerpt)"
                               FontWeight="SemiBold"
                               Opacity="0.8" />
                    <TextBlock x:Name="RawText"
                               TextWrapping="WrapWholeWords"
                               FontFamily="Consolas"
                               FontSize="12"
                               Opacity="0.75" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Opacity="0.85" />
            <InfoBar x:Name="ErrorBar"
                     Severity="Error"
                     IsClosable="False"
                     Title="Scan problem" />
        </StackPanel>
    </Grid>
</Page>

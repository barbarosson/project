<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PurePerformance.Views.CrashAnalyzerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PurePerformance.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock Text="Crash Analyzer"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Reads Application and System Event Viewer logs for kernel-power events, app hangs, disk errors, and BSODs. Results include plain-English explanations — nothing is deleted. Findings are fully copyable."
                       TextWrapping="WrapWholeWords"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       Opacity="0.92" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="Lookback"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="12" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton Content="Last 24 hours"
                                 IsChecked="{x:Bind ViewModel.IsLookback24, Mode=TwoWay}"
                                 GroupName="Lookback"
                                 Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <RadioButton Content="Last 72 hours"
                                 IsChecked="{x:Bind ViewModel.IsLookback72, Mode=TwoWay}"
                                 GroupName="Lookback"
                                 Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </StackPanel>

            <Button Content="Scan Event Logs"
                    Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.ScanCommand}"
                    IsEnabled="{x:Bind ViewModel.CanScan, Mode=OneWay}" />

            <Button Content="Cancel"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.CancelScanCommand}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <Button Content="Copy selected"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.CopySelectedCommand}"
                    IsEnabled="{x:Bind ViewModel.CanCopy, Mode=OneWay}" />

            <Button Content="Copy all"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.CopyAllCommand}"
                    IsEnabled="{x:Bind ViewModel.CanScan, Mode=OneWay}" />

            <ProgressRing Width="28"
                          Height="28"
                          VerticalAlignment="Bottom"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView ItemsSource="{x:Bind ViewModel.Findings, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedFinding, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:CrashEvent">
                        <StackPanel Spacing="2" Padding="4,8">
                            <TextBlock Text="{x:Bind Title}"
                                       FontWeight="SemiBold"
                                       TextWrapping="WrapWholeWords"
                                       IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind SummaryLine}"
                                       FontSize="12"
                                       TextWrapping="WrapWholeWords"
                                       IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Details"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Button Content="Copy selected"
                                Command="{x:Bind ViewModel.CopySelectedCommand}"
                                IsEnabled="{x:Bind ViewModel.CanCopy, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Read-only Text boxes: selectable + Ctrl+C on all themes -->
                    <TextBlock Text="Explanation"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBox Text="{x:Bind ViewModel.ExplanationText, Mode=OneWay}"
                             TextWrapping="Wrap"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             MinHeight="72"
                             Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    <TextBlock Text="Recommended fix"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBox Text="{x:Bind ViewModel.FixText, Mode=OneWay}"
                             TextWrapping="Wrap"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             MinHeight="72"
                             Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    <TextBlock Text="Raw message (excerpt)"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox Text="{x:Bind ViewModel.RawText, Mode=OneWay}"
                             TextWrapping="Wrap"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             MinHeight="80"
                             FontFamily="Consolas"
                             FontSize="12"
                             Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="Pro AI assist (optional)"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Uses your own OpenAI-compatible API key from Settings. The app never ships a key. Built-in explanations stay free without AI."
                                   TextWrapping="WrapWholeWords"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12" />
                        <Button Content="Suggest fix with AI…"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.AskAiCommand}"
                                IsEnabled="{x:Bind ViewModel.CanRequestAi, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.AiStatus, Mode=OneWay}"
                                   TextWrapping="WrapWholeWords"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox Text="{x:Bind ViewModel.AiSuggestion, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 MinHeight="100"
                                 PlaceholderText="AI suggestion appears here when Pro is unlocked and a key is saved."
                                 Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       Opacity="0.9" />
            <TextBlock Text="{x:Bind ViewModel.CopyStatus, Mode=OneWay}"
                       Foreground="{ThemeResource TextTextFillColorSecondaryBrush}"
                       FontSize="12" />
            <InfoBar x:Name="ErrorBar"
                     Severity="Error"
                     IsClosable="False"
                     Title="Scan problem" />
        </StackPanel>
    </Grid>
</Page>

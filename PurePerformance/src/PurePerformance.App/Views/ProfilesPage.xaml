<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="PurePerformance.Views.ProfilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:PurePerformance.Models"
      NavigationCacheMode="Disabled">
  <ScrollViewer Padding="24">
    <StackPanel Spacing="16" MaxWidth="760">
      <TextBlock Text="Multi-PC profiles" Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
      <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Honest status"
               Message="Local profiles work on this PC. Cloud sync is not connected in this build — nothing is uploaded." />
      <TextBlock Text="{x:Bind ViewModel.CloudStatus, Mode=OneWay}" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBox Width="240" PlaceholderText="New profile name" Text="{x:Bind ViewModel.NewProfileName, Mode=TwoWay}" />
        <Button Content="Add local profile" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.AddCommand}" />
        <Button Content="Try cloud sync…" Command="{x:Bind ViewModel.CloudSyncCommand}" />
      </StackPanel>
      <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
      <ListView x:Name="ProfileList" ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}" SelectionMode="Single">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="models:PcProfile">
            <StackPanel Padding="8" Spacing="2">
              <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
              <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True">
                <Run Text="{x:Bind MachineName}" /><Run Text=" · updated " /><Run Text="{x:Bind UpdatedUtc}" />
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="Set active" Click="Activate_Click" />
        <Button Content="Remove" Click="Remove_Click" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>

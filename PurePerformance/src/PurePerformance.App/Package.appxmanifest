<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap rescap desktop">

  <!--
    *** PUBLISHER / IDENTITY PLACEHOLDERS (Partner Center — Barbaros only) ***
    - Identity/@Publisher (CN=…) MUST match the signing certificate from Partner Center.
      "CN=Modulus" below is a LOCAL DEVELOPMENT PLACEHOLDER.
      Visual Studio → Project → Package and Publish → Associate App with the Store
      rewrites Name + Publisher to the reserved Store identity — do that before upload.
    - PublisherDisplayName should match the Partner Center publisher display name.
    - Version: bump Identity/@Version (and csproj ApplicationDisplayVersion) for every Store upload.
    See docs/STORE-SUBMISSION.md and docs/MSIX-PACKAGING.md.
  -->
  <Identity
    Name="Modulus.PurePerformance"
    Publisher="CN=Modulus"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>Pure Performance</DisplayName>
    <PublisherDisplayName>Modulus</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>
      Pure Performance is a Crash Analyzer and Startup Manager for Windows.
      Free: Event Log crash diagnosis, live dashboard, Startup Manager, named-folder System Cleaner, and Memory Optimizer.
      Optional Pro: scheduled reports, advanced crash tools, auto rules, profiles, alerts, whitelist, and bring-your-own AI assist.
      Not a registry cleaner. No deceptive “junk score” cleanup claims.
    </Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Pure Performance"
        Description="Crash Analyzer + Startup Manager for Windows. Free named-folder cleanup — not a registry cleaner. Optional Pro productivity add-on."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"
                        Square71x71Logo="Assets\Square71x71Logo.png"
                        Square310x310Logo="Assets\Square310x310Logo.png"
                        ShortName="Pure Performance">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
            <uap:ShowOn Tile="square310x310Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <!--
    Store / Desktop Bridge checklist notes:
    - Position as Crash Analyzer + Startup Manager (honest listing).
    - internetClient: Store license / purchase + privacy policy hyperlink.
    - runFullTrust: REQUIRED for Event Log, startup edits, and named-folder cleanup
      under MSIX Desktop Bridge. Do not add other restricted capabilities “just in case”.
    - Elevate via UAC only when the user starts an admin-needed action (asInvoker day-to-day).
    - Privacy policy URL for Partner Center: see docs/PRIVACY.md
      (https://modulusaas.com/products/pure-performance/privacy) — publish the page before cert.
    - Brand assets under Assets/ (StoreLogo, Square*, Wide, Splash, ApplicationIcon.ico).
    - Pro durable add-on Store ID is a CODE PLACEHOLDER (9NXXXXXXXXXX) until Partner Center
      creates the add-on — see StoreLicenseService.DefaultProAddOnStoreId.
  -->
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>

# Copy to `.env.local` (local) or Netlify Environment variables (staging/production).
# See docs/deploy-model-b.md in the repo root for Model B (isendai.com + staging).

# --- Site / deploy ---
NEXT_PUBLIC_SITE_URL=https://isendai.com
NEXT_PUBLIC_DEPLOY_ENV=production
# pending_review | test | live | unconfigured — production must be `live`
NEXT_PUBLIC_LEMON_MERCHANT_STATUS=live
# Optional alias when MERCHANT_STATUS unset: set to 1 on production
# LEMON_SQUEEZY_LIVE_MODE=1
# Staging only: link to production from the yellow banner
NEXT_PUBLIC_PRODUCTION_SITE_URL=https://isendai.com

# Public support address (mailto on /contact)
NEXT_PUBLIC_SUPPORT_EMAIL=info@modulustech.app

# Google Analytics 4 (production only; loaded when NEXT_PUBLIC_DEPLOY_ENV=production)
NEXT_PUBLIC_GA_ID=

# Optional: POST JSON error payloads to Slack/Discord/custom (server + /api/client-error)
# ERROR_WEBHOOK_URL=

# --- Supabase (Auth + isendai schema) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sign-In (GIS + signInWithIdToken) — same Web Client ID as Supabase Google provider.
# When set, Google consent shows isendai.com instead of *.supabase.co. See docs/google-sign-in-isendai-domain.md
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# --- AI providers (at least OPENAI_API_KEY required for core tools) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Optional: model catalog overrides (JSON). See ai-suite/docs/model-catalog.md
# ISENDAI_MODEL_CATALOG_JSON={"tierModels":{"pro-ai":"claude-sonnet-4-6"}}
# ISENDAI_EXTRA_MODELS_JSON={"models":[{"id":"my-model","label":"Vendor · My Model","provider":"openai","pricing":{"inputPer1MTokensUSD":1,"outputPer1MTokensUSD":2}}]}

# --- Lemon Squeezy — LIVE toggle ON in dashboard, then copy Live API key + Live variant IDs ---
# Test and Live keys/variant IDs are different; test keys always open test checkout.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=

# Subscription variants (monthly)
LEMON_SQUEEZY_VARIANT_BASIC_MONTHLY=
LEMON_SQUEEZY_VARIANT_PRO_MONTHLY=
LEMON_SQUEEZY_VARIANT_ULTRA_MONTHLY=

# Subscription variants (yearly, ~20% off — optional until products exist)
LEMON_SQUEEZY_VARIANT_BASIC_YEARLY=
LEMON_SQUEEZY_VARIANT_PRO_YEARLY=
LEMON_SQUEEZY_VARIANT_ULTRA_YEARLY=

# One-time pack ($1.49 → 10 credits). Legacy fallback: LEMON_SQUEEZY_VARIANT_ID
LEMON_SQUEEZY_VARIANT_ONE_TIME_TRIAL=

# Pay-as-you-go credit packs (one variant per tier; credits from PAYGO_PACK_CREDITS in code)
LEMON_SQUEEZY_VARIANT_PAYGO_BUDGET=
LEMON_SQUEEZY_VARIANT_PAYGO_STANDARD=
LEMON_SQUEEZY_VARIANT_PAYGO_PREMIUM=

# Webhook signing secret from Lemon dashboard (production webhook: https://isendai.com/api/webhook)
LEMONSQUEEZY_WEBHOOK_SECRET=

# Optional: strict IP fingerprint at checkout (subscription trial). Default off.
# ISENDAI_STRICT_TRIAL_IP=1

# Optional: local dev credit top-up (never set in production; route returns 404 there)
# DEV_TOPUP_SECRET=

# Optional: distributed rate limits (recommended for production / multi-instance)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Concierge abuse guards (production: auth required by default; set ISENDAI_CONCIERGE_REQUIRE_AUTH=0 to allow anon)
# ISENDAI_CONCIERGE_RPM=12
# ISENDAI_CONCIERGE_DAILY_MAX=40
# ISENDAI_CONCIERGE_REQUIRE_AUTH=1

# Feedback (production: sign-in required by default)
# ISENDAI_FEEDBACK_REQUIRE_AUTH=1

# Webhook: reject credit grants when Lemon buyer email ≠ Supabase user email (on by default in production)
# ISENDAI_WEBHOOK_STRICT_EMAIL=0

# Generation debug headers (x-ai-model, etc.) in production
# ISENDAI_DEBUG_HEADERS=1

# CSP report-only mode (log violations without blocking)
# ISENDAI_CSP_REPORT_ONLY=1

# Data retention: purge isendai.requests older than N days (min 30). Cron: POST /api/internal/purge-requests
# CRON_SECRET=
# ISENDAI_REQUEST_RETENTION_DAYS=365

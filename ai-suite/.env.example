## AI Suite environment variables
##
## Copy this file to `.env.local` (same directory) and fill in values.
## IMPORTANT: `.env.local` should NOT be committed.

# Required for /api/generate and /api/concierge
OPENAI_API_KEY=

# Optional (only needed if you use the Stripe redirect flow)
# You can define one per tool+model, or leave empty to use /success?test=1 fallback.
# Example:
# NEXT_PUBLIC_STRIPE_LINK_CORPORATE_WHISPERER_GPT_4O_MINI=https://buy.stripe.com/...

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Stripe Payment Links (set each link to redirect back to your app after successful payment)
NEXT_PUBLIC_STRIPE_LINK_CORPORATE_WHISPERER=
NEXT_PUBLIC_STRIPE_LINK_COVERLETTER_AI=
NEXT_PUBLIC_STRIPE_LINK_DATING_ROAST=

# Optional: model-specific payment links (if you price per model)
# Suffix format:
# - GPT‑4o mini: _GPT_4O_MINI
# - GPT‑4.1 mini: _GPT_4_1_MINI
# - GPT‑4o: _GPT_4O
NEXT_PUBLIC_STRIPE_LINK_CORPORATE_WHISPERER_GPT_4O_MINI=
NEXT_PUBLIC_STRIPE_LINK_CORPORATE_WHISPERER_GPT_4_1_MINI=
NEXT_PUBLIC_STRIPE_LINK_CORPORATE_WHISPERER_GPT_4O=

# New tools
NEXT_PUBLIC_STRIPE_LINK_RAISE_NEGOTIATOR=
NEXT_PUBLIC_STRIPE_LINK_GRACEFUL_QUITTER=

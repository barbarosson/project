## AI Suite environment variables
##
## Copy this file to `.env.local` (same directory) and fill in values.
## IMPORTANT: `.env.local` should NOT be committed.
## Run the dev server from this directory so Next loads env: `cd ai-suite && npm run dev`

# Supabase (required for auth, credits, history)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Social login: enable Apple, X, LinkedIn (OIDC), Facebook, and optionally Custom OAuth “tiktok”
# in Supabase Dashboard → Authentication → Providers. Site URL / redirect must allow:
#   https://YOUR_DOMAIN/auth/callback
# Optional: same values without NEXT_PUBLIC_ — read at runtime on the server (helps some hosts if public vars were missing at build)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only (required for DB writes, dev topup, anon flows)
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Postgres URI (Dashboard → Database → Connection string). Bypasses PostgREST for billing RPCs
# when `public.charge_and_create_request` / schema cache errors occur. Prefer Session pooler or direct DB port.
# SUPABASE_DATABASE_URL=postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# DIRECT_POSTGRES_URL=

# Optional: in-memory rate limits (requests / minute / IP per server instance)
ISENDAI_GENERATE_RPM=60
ISENDAI_VERSION_RPM=90

# Required for /api/generate and /api/concierge
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Lemon Squeezy (Merchant of Record checkout + webhooks)
# Apply supabase/migrations/20260513120000_lemon_processed_orders.sql so webhooks can dedupe orders.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
# Single-use pack variant (e.g. $1.49 tier in Lemon dashboard)
LEMON_SQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Credits granted per completed order (default 10 if unset)
LEMON_SQUEEZY_CREDITS_PER_ORDER=10

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site base URL (checkout redirect + metadata). Falls back to request origin if unset.
NEXT_PUBLIC_SITE_URL=https://isendai.netlify.app

# Optional: require secret header for POST /api/dev/topup in non-production (X-Dev-Topup-Secret or Authorization: Bearer)
# DEV_TOPUP_SECRET=


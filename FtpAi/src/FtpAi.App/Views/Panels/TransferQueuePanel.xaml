<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FtpAi.Views.Panels.TransferQueuePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FtpAi.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="8,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Transfer queue" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SummaryText}" Opacity="0.7" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="Pause" Command="{Binding PauseSelectedCommand}" Padding="10,4"/>
                <Button Content="Resume" Command="{Binding ResumeSelectedCommand}" Padding="10,4"/>
                <Button Content="Cancel" Command="{Binding CancelSelectedCommand}" Padding="10,4"/>
                <Button Content="Retry" Command="{Binding RetrySelectedCommand}" Padding="10,4"/>
                <Button Content="Clear done" Command="{Binding ClearSuccessfulCommand}" Padding="10,4"/>
                <Button Content="Clear failed" Command="{Binding ClearFailedCommand}" Padding="10,4"/>
            </StackPanel>
        </Grid>

        <TabView Grid.Row="1"
                  IsAddTabButtonVisible="False"
                  SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabView.TabItems>
                <TabViewItem Header="Queued" IsClosable="False">
                    <ListView ItemsSource="{Binding QueuedItems}"
                              SelectedItem="{Binding SelectedQueued, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TransferQueueItemViewModel">
                                <Grid Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Direction, Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind DisplayName, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Detail, Mode=OneWay}"
                                                   FontSize="11"
                                                   Opacity="0.75"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar Minimum="0"
                                                     Maximum="100"
                                                     Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                                     Height="6"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind Status, Mode=OneWay}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4"
                                               Text="{x:Bind Destination, Mode=OneWay}"
                                               FontSize="11"
                                               Opacity="0.7"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </TabViewItem>

                <TabViewItem Header="Failed" IsClosable="False">
                    <ListView ItemsSource="{Binding FailedItems}"
                              SelectedItem="{Binding SelectedFailed, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TransferQueueItemViewModel">
                                <Grid Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Direction, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Status, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind Detail, Mode=OneWay}" Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </TabViewItem>

                <TabViewItem Header="Successful" IsClosable="False">
                    <ListView ItemsSource="{Binding SuccessfulItems}"
                              SelectedItem="{Binding SelectedSuccessful, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TransferQueueItemViewModel">
                                <Grid Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Direction, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Source, Mode=OneWay}" TextTrimming="CharacterEllipsis" Opacity="0.75"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind Destination, Mode=OneWay}" TextTrimming="CharacterEllipsis" Opacity="0.75"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </TabViewItem>
            </TabView.TabItems>
        </TabView>
    </Grid>
</UserControl>

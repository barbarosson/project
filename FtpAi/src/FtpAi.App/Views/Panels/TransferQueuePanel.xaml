<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FtpAi.Views.Panels.TransferQueuePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FtpAi.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="8,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Transfer queue" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="ADIM 5 will add pause / resume / retry and concurrency limits"
                       Opacity="0.6"
                       VerticalAlignment="Center"
                       FontSize="12"/>
        </StackPanel>

        <ListView Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  SelectionMode="None"
                  Margin="0,4,0,0">
            <ListView.Header>
                <Grid Margin="4,0,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Dir" Opacity="0.7"/>
                    <TextBlock Grid.Column="1" Text="Source" Opacity="0.7"/>
                    <TextBlock Grid.Column="2" Text="Destination" Opacity="0.7"/>
                    <TextBlock Grid.Column="3" Text="Status" Opacity="0.7"/>
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TransferQueueItemViewModel">
                    <Grid Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Direction}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Source}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind Destination}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind Status, Mode=OneWay}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>

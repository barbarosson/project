<Window x:Class="HaSetup.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Home Assistant"
        Height="780" Width="960"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource ChromePanel}" Padding="18,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0"
                       Source="/Assets/app-logo.png"
                       Width="48" Height="48"
                       Margin="0,0,16,0"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Smart Home Assistant" Style="{StaticResource BrandTitle}" />
                    <TextBlock Text="Set up Home Assistant automatically with Docker Desktop"
                               Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ChannelLabel}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding BusyText}"
                               Foreground="#7BE0B4"
                               FontWeight="SemiBold"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- First-run / listing disclosure -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorder}"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5"
                Background="{StaticResource AccentSoftBrush}">
            <StackPanel>
                <TextBlock Text="Important — Docker Desktop required" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding DockerRequirementDisclosure}" Style="{StaticResource BodyText}" />
            </StackPanel>
        </Border>

        <!-- Status panel -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Docker" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding DockerStatusText}" Style="{StaticResource StatusValue}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Container" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding ContainerStatusText}" Style="{StaticResource StatusValue}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Health (port 8123)" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding HealthStatusText}" Style="{StaticResource StatusValue}" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource ContentMutedText}">
                        <Run Text="URL: " />
                        <Run Text="{Binding LocalUrl, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Actions -->
        <Border Grid.Row="3" Style="{StaticResource ChromePanel}">
            <StackPanel>
                <TextBlock Text="Actions" Style="{StaticResource ChromeSectionTitle}" />
                <WrapPanel>
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Open Docker in Store" Command="{Binding OpenDockerStoreCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="Download Docker" Command="{Binding OpenDockerDownloadCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Try silent install"
                            Command="{Binding InstallDockerCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Visibility="{Binding ShowSilentInstall, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Install / Start" Command="{Binding CreateStartCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Restart" Command="{Binding RestartCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Open in browser" Command="{Binding OpenBrowserCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="Fetch logs" Command="{Binding LoadLogsCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Remove container" Command="{Binding RemoveCommand}" Style="{StaticResource DangerButton}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Next steps + logs -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,8,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding NextStepsTitle}" Style="{StaticResource SectionTitle}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <TextBlock Text="{Binding NextStepsBody}" Style="{StaticResource BodyText}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource ChromePanel}" Margin="8,0,0,0" Padding="16">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="Log / output" Style="{StaticResource ChromeSectionTitle}" />
                    <Border CornerRadius="6" Background="{StaticResource LogBgBrush}" ClipToBounds="True">
                        <TextBox Text="{Binding LogText, Mode=OneWay}" Style="{StaticResource LogBox}" />
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="5"
                   Style="{StaticResource MutedText}"
                   Margin="0,4,0,0"
                   FontSize="12"
                   Text="Out of scope: Zigbee/USB, Supervisor add-ons, Proxmox, cloud tunnels. Docker is not installed by the Store package." />
    </Grid>
</Window>

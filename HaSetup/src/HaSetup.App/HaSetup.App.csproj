<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>HaSetup.App</RootNamespace>
    <AssemblyName>HaSetup</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationTitle>Smart Home — Home Assistant Kurulum</ApplicationTitle>
    <!-- Allow restore/design-time on non-Windows CI; full WPF build still needs Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HaSetup.Core\HaSetup.Core.csproj" />
  </ItemGroup>

</Project>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows Application Packaging Project for Container Manager for HA (HaSetup.App).
  Build on Windows with Visual Studio 2022 (Windows application packaging / MSIX tooling).
  Store channel: msbuild with /p:StoreBuild=true so STORE_BUILD disables silent Docker install.
-->
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <ProjectGuid>{B7E2C4A1-9F3D-4E8B-A012-6D5E8F9A0B1C}</ProjectGuid>
    <WorkflowProjectType>WAPProjectType</WorkflowProjectType>
  </PropertyGroup>

  <PropertyGroup>
    <WapProjPath Condition="'$(WapProjPath)'==''">$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\AppxPackage</WapProjPath>
    <TargetPlatformIdentifier>UAP</TargetPlatformIdentifier>
    <TargetPlatformVersion>10.0.22621.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <AppxBundle>Never</AppxBundle>
    <EntryPointProjectUniqueName>..\..\src\HaSetup.App\HaSetup.App.csproj</EntryPointProjectUniqueName>
    <!-- Propagate Store channel into the WPF app for Store packages. -->
    <StoreBuild Condition="'$(StoreBuild)'==''">true</StoreBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <AppxShowAllApps>False</AppxShowAllApps>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <AppxShowAllApps>False</AppxShowAllApps>
  </PropertyGroup>

  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.props" Condition="Exists('$(WapProjPath)\Microsoft.DesktopBridge.props')" />

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Images\StoreLogo.png" />
    <Content Include="Images\Square150x150Logo.png" />
    <Content Include="Images\Square44x44Logo.png" />
    <Content Include="Images\Wide310x150Logo.png" />
    <Content Include="Images\SplashScreen.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HaSetup.App\HaSetup.App.csproj">
      <SkipGetTargetFrameworkProperties>True</SkipGetTargetFrameworkProperties>
      <Properties>StoreBuild=$(StoreBuild)</Properties>
    </ProjectReference>
  </ItemGroup>

  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.targets" Condition="Exists('$(WapProjPath)\Microsoft.DesktopBridge.targets')" />
</Project>

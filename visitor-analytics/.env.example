# SQLite local (default). For Neon/Supabase Postgres use:
# DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"
# and change prisma/schema.prisma provider to "postgresql".
DATABASE_URL="file:./dev.db"

# Session signing secret (min 32 chars in production)
AUTH_SECRET="change-me-to-a-long-random-string"

# Public app URL (used in snippet install docs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (Supabase Postgres) ---
# Dashboard: Project Settings → Database → Connection string
# Runtime (Netlify + app): Transaction pooler :6543 + pgbouncer
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Prisma migrate / db push: Direct (or Session) :5432 — no pgbouncer
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
# Or Direct host: postgresql://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres?sslmode=require
# Validate + push when URLs are set: npm run db:validate-push
# Offline SQLite only: change prisma/schema.prisma provider to "sqlite", remove directUrl, and use:
# DATABASE_URL="file:./dev.db"

# Session signing secret (min 32 chars in production)
AUTH_SECRET="change-me-to-a-long-random-string"

# Public app URL (snippet install docs, invite links, LS redirect)
# After Netlify deploy, set to https://YOUR-SITE.netlify.app (no trailing slash), then redeploy
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Lemon Squeezy MoR (optional until launch; app builds/runs without these) ---
# Step-by-step: docs/lemon-squeezy-setup.md (Project store) or DEPLOY.md
# Set these in Netlify UI → Site configuration → Environment variables
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_VARIANT_STARTER=
# LEMONSQUEEZY_VARIANT_AGENCY=
# LEMONSQUEEZY_VARIANT_SCALE=
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/webhooks/lemonsqueezy
# Local stub test: POST with header X-SitePulse-Stub: 1 (only when secret unset)

# --- Optional email outbound (weekly digest / quota / spike) ---
# Without these, digests still create in-app notifications + console stub log.
# RESEND_API_KEY=
# RESEND_FROM="SitePulse <onboarding@resend.dev>"
# Or SMTP intent (logged stub until a transport is added):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

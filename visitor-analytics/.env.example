# --- Database (Neon free Postgres for local + production) ---
# Dashboard: https://console.neon.tech → Connection string (pooled, sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Offline SQLite only: change prisma/schema.prisma provider to "sqlite" and use:
# DATABASE_URL="file:./dev.db"

# Session signing secret (min 32 chars in production)
AUTH_SECRET="change-me-to-a-long-random-string"

# Public app URL (snippet install docs, invite links, LS redirect)
# After Vercel deploy, set to https://YOUR-PROJECT.vercel.app (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Lemon Squeezy MoR (optional until launch; app builds/runs without these) ---
# Step-by-step: docs/lemon-squeezy-setup.md (Project store) or DEPLOY.md
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_VARIANT_STARTER=
# LEMONSQUEEZY_VARIANT_AGENCY=
# LEMONSQUEEZY_VARIANT_SCALE=
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/webhooks/lemonsqueezy
# Local stub test: POST with header X-SitePulse-Stub: 1 (only when secret unset)

# SQLite local (default). For Neon/Supabase Postgres use:
# DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"
# and change prisma/schema.prisma provider to "postgresql".
DATABASE_URL="file:./dev.db"

# Session signing secret (min 32 chars in production)
AUTH_SECRET="change-me-to-a-long-random-string"

# Public app URL (used in snippet install docs + invite links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Lemon Squeezy MoR (optional; app builds/runs without these) ---
# Create a store + subscription products, then fill:
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_VARIANT_STARTER=
# LEMONSQUEEZY_VARIANT_AGENCY=
# LEMONSQUEEZY_VARIANT_SCALE=
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/webhooks/lemonsqueezy
# Local stub test: POST with header X-SitePulse-Stub: 1 (only when secret unset)

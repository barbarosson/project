<Window x:Class="WinAirPlay.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinAirPlay.App.Views"
        Title="WinAirPlay"
        Width="440"
        Height="880"
        MinWidth="400"
        MinHeight="480"
        Background="{StaticResource SurfaceBrush}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <views:StateToBrushConverter x:Key="StateToBrush" />
        <views:InverseBooleanConverter x:Key="Not" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="MeterBar" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{StaticResource BorderBrush}" CornerRadius="3" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        Background="{StaticResource SuccessBrush}"
                                        CornerRadius="3"
                                        HorizontalAlignment="Left" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40"
                        Height="40"
                        CornerRadius="10"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Margin="0,0,12,0">
                    <Image Width="30"
                           Height="30"
                           Source="{Binding AppLogo}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Text="WinAirPlay" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                        <TextBlock Margin="7,0,0,0" FontSize="11" Text="{Binding StateText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- Leaves room for the scrollbar so hint text is never hidden underneath it. -->
            <StackPanel Margin="0,0,4,0">

        <!-- Target device -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{Binding TargetDeviceCaption}" Style="{StaticResource CaptionText}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              Tag="{Binding NoDevicesText}"
                              Style="{StaticResource ModernComboBox}"
                              ItemContainerStyle="{StaticResource ModernComboBoxItem}"
                              ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                              IsEnabled="{Binding IsStreaming, Converter={StaticResource Not}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}  ·  {1}">
                                                <Binding Path="Address" />
                                                <Binding Path="Model" TargetNullValue="AirPlay" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="1"
                            Margin="10,0,0,0"
                            Content="{Binding ScanButtonText}"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ScanCommand}" />
                </Grid>

                <TextBlock Margin="0,14,0,6" Text="{Binding AudioSourceCaption}" Style="{StaticResource CaptionText}" />
                <ComboBox Style="{StaticResource ModernComboBox}"
                          ItemContainerStyle="{StaticResource ModernComboBoxItem}"
                          ItemsSource="{Binding CaptureDevices}"
                          SelectedItem="{Binding SelectedCaptureDevice, Mode=TwoWay}"
                          IsEnabled="{Binding IsStreaming, Converter={StaticResource Not}}" />
            </StackPanel>
        </Border>

        <!-- Tuning -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{Binding BufferLatencyCaption}" Style="{StaticResource CaptionText}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="−"
                                Width="32"
                                Height="28"
                                Padding="0"
                                Margin="0,0,8,0"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding DecreaseLatencyCommand}" />
                        <TextBlock Style="{StaticResource ValueText}"
                                   VerticalAlignment="Center"
                                   MinWidth="52"
                                   TextAlignment="Center"
                                   Text="{Binding LatencyText}" />
                        <Button Content="+"
                                Width="32"
                                Height="28"
                                Padding="0"
                                Margin="8,0,0,0"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding IncreaseLatencyCommand}" />
                    </StackPanel>
                </Grid>
                <Slider Style="{StaticResource ModernSlider}"
                        Minimum="0"
                        Maximum="2000"
                        SmallChange="10"
                        LargeChange="100"
                        TickFrequency="10"
                        IsSnapToTickEnabled="True"
                        Value="{Binding LatencyMs, Mode=TwoWay}" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{Binding LatencyHint}" />

                <Grid Margin="0,18,0,0">
                    <TextBlock Text="{Binding VolumeCaption}" Style="{StaticResource CaptionText}" />
                    <TextBlock HorizontalAlignment="Right"
                               Style="{StaticResource ValueText}"
                               Text="{Binding VolumeText}" />
                </Grid>
                <Slider Style="{StaticResource ModernSlider}"
                        Minimum="0"
                        Maximum="100"
                        SmallChange="1"
                        LargeChange="10"
                        Value="{Binding VolumePercent, Mode=TwoWay}" />

                <CheckBox Margin="0,18,0,0"
                          Foreground="{StaticResource TextBrush}"
                          IsEnabled="{Binding IsStreaming, Converter={StaticResource Not}}"
                          IsChecked="{Binding UseAlac, Mode=TwoWay}"
                          Content="{Binding AlacEncodingText}" />
                <TextBlock Margin="24,2,0,0"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{Binding CodecHint}" />

                <CheckBox Margin="0,14,0,0"
                          Foreground="{StaticResource TextBrush}"
                          IsEnabled="{Binding IsStreaming, Converter={StaticResource Not}}"
                          IsChecked="{Binding MuteLocalSpeakers, Mode=TwoWay}"
                          Content="{Binding MuteSpeakersText}" />
                <TextBlock Margin="24,2,0,0"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{Binding MuteSpeakersHint}" />

                <CheckBox Margin="0,14,0,0"
                          Foreground="{StaticResource TextBrush}"
                          IsChecked="{Binding AutoConnect, Mode=TwoWay}"
                          Content="{Binding AutoConnectText}" />

                <CheckBox Margin="0,10,0,0"
                          Foreground="{StaticResource TextBrush}"
                          IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                          Content="{Binding StartMinimizedText}" />

                <TextBlock Margin="0,18,0,6" Text="{Binding LanguageCaption}" Style="{StaticResource CaptionText}" />
                <ComboBox Style="{StaticResource ModernComboBox}"
                          ItemContainerStyle="{StaticResource ModernComboBoxItem}"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedValue="{Binding Language, Mode=TwoWay}"
                          SelectedValuePath="Value"
                          DisplayMemberPath="Label"
                          IsEnabled="{Binding IsStreaming, Converter={StaticResource Not}}" />
            </StackPanel>
        </Border>

        <!-- Live statistics -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{Binding StreamingCaption}" Style="{StaticResource CaptionText}" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="L" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="R" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <ProgressBar Style="{StaticResource MeterBar}" Value="{Binding PeakLeft, Mode=OneWay}" Margin="0,0,0,5" />
                        <ProgressBar Style="{StaticResource MeterBar}" Value="{Binding PeakRight, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,8,0,0">
                        <TextBlock Text="{Binding DurationCaption}" Style="{StaticResource CaptionText}" />
                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding PositionText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ThroughputCaption}" Style="{StaticResource CaptionText}" />
                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding ThroughputText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                        <TextBlock Text="{Binding PacketsCaption}" Style="{StaticResource CaptionText}" />
                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding PacketText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                        <TextBlock Text="{Binding EncodingCaption}" Style="{StaticResource CaptionText}" />
                        <TextBlock Style="{StaticResource ValueText}" Text="{Binding CodecText}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Margin="2,0,0,12"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"
                       Text="{Binding StatusText}" />

            <Button Height="44"
                    Content="{Binding ConnectionButtonText}"
                    Command="{Binding ToggleConnectionCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>

# Local signing / Store identity — copy to signing.env (do not commit secrets).
# Public Partner Center identity is filled in below. Certificate paths/passwords stay empty.
# Never commit signing.env, .pfx, or cert passwords.

UPLINK_SIGNING_CERT_THUMBPRINT=
UPLINK_SIGNING_CERT_PATH=
UPLINK_SIGNING_CERT_PASSWORD=

# Package identity (matches Package.appxmanifest / Partner Center)
STORE_PUBLISHER=CN=7E7A2323-C3C3-4A9A-A4D1-832D351FC4BA
STORE_PUBLISHER_DISPLAY_NAME=MODULUSTECH
STORE_PACKAGE_IDENTITY_NAME=MODULUSTECH.UplinkFTP

# App listing Store ID (public). Pro add-on ID: set only after Partner Center creates it.
UPLINK_STORE_APP_ID=9MZKMN2ZH0DG
UPLINK_STORE_PRO_ADDON_ID=

UPLINK_UPDATE_CHANNEL_BASE_URL=

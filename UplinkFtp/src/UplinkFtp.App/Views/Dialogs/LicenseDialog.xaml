<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="UplinkFtp.Views.Dialogs.LicenseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="License"
    PrimaryButtonText="Close"
    DefaultButton="Primary"
    MinWidth="440">

    <StackPanel Spacing="12" MinWidth="400" Padding="0,4,0,0">
        <!-- Prefer TextBlock.Text over Run+x:Bind (Run bindings are unreliable in WinUI). -->
        <TextBlock FontWeight="SemiBold"
                   Text="{x:Bind ViewModel.ChannelLine, Mode=OneWay}"/>
        <TextBlock FontWeight="SemiBold"
                   Text="{x:Bind ViewModel.TierLine, Mode=OneWay}"/>
        <TextBlock Text="{x:Bind ViewModel.StatusDetail, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Opacity="0.85"/>
        <TextBlock Text="{x:Bind ViewModel.PurchaseInfo, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Opacity="0.75"
                   FontSize="12"/>

        <StackPanel x:Name="WebKeyPanel" Spacing="8">
            <TextBox Header="License key"
                     Text="{x:Bind ViewModel.LicenseKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Paste your Pro key"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Activate"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.ActivateCommand}"
                        MinWidth="96"/>
                <Button Content="Clear"
                        Command="{x:Bind ViewModel.ClearCommand}"
                        MinWidth="72"/>
            </StackPanel>
        </StackPanel>

        <Button Content="Refresh status"
                Command="{x:Bind ViewModel.RefreshCommand}"
                HorizontalAlignment="Left"
                MinWidth="120"/>

        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Opacity="0.75"
                   FontSize="12"/>
    </StackPanel>
</ContentDialog>

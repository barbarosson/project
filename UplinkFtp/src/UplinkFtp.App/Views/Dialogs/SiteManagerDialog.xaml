<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="UplinkFtp.Views.Dialogs.SiteManagerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Sites"
    PrimaryButtonText="Close"
    DefaultButton="Primary"
    FontFamily="{StaticResource UplinkUiFont}">

    <!-- Wider than default ~548px so Protocol / New·Add·Save·Delete / Connect never clip. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">680</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">780</x:Double>
    </ContentDialog.Resources>

    <Grid Width="720" MaxWidth="720">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MaxHeight="420"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2"
                Background="{ThemeResource UplinkSectionFillBrush}"
                BorderBrush="{ThemeResource UplinkSectionStrokeBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Saved sites"
                           Style="{StaticResource UplinkMutedTextStyle}"
                           Margin="4,2,4,6"/>
                <ListView x:Name="SitesList"
                          Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Sites, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedSite, Mode=TwoWay}"
                          SelectionChanged="SitesList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="2" Padding="2,6">
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource UplinkBodyTextStyle}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Style="{StaticResource UplinkMutedTextStyle}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Host}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Protocol}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,0,8"
                      Padding="0,0,8,0">
            <StackPanel Spacing="8">
                <TextBlock Text="Site details" Style="{StaticResource UplinkDialogTitleStyle}"/>
                <TextBox Header="Name"
                         FontFamily="{StaticResource UplinkUiFont}"
                         Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="My server"
                         HorizontalAlignment="Stretch"/>
                <TextBox Header="Host"
                         FontFamily="{StaticResource UplinkUiFont}"
                         Text="{x:Bind ViewModel.Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="ftp.example.com"
                         HorizontalAlignment="Stretch"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Header="Port"
                             FontFamily="{StaticResource UplinkUiFont}"
                             Text="{x:Bind ViewModel.PortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Stretch"/>
                    <ComboBox Grid.Column="2"
                              Header="Protocol"
                              FontFamily="{StaticResource UplinkUiFont}"
                              ItemsSource="{x:Bind ViewModel.ProtocolOptions}"
                              SelectedItem="{x:Bind ViewModel.Protocol, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              MinWidth="0"/>
                </Grid>
                <TextBox Header="User"
                         FontFamily="{StaticResource UplinkUiFont}"
                         Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="anonymous"
                         HorizontalAlignment="Stretch"/>
                <PasswordBox x:Name="SitePasswordBox"
                             Header="Password"
                             FontFamily="{StaticResource UplinkUiFont}"
                             PasswordChanged="SitePasswordBox_PasswordChanged"
                             HorizontalAlignment="Stretch"/>
                <TextBox Header="Private key path (SFTP)"
                         FontFamily="{StaticResource UplinkUiFont}"
                         Text="{x:Bind ViewModel.PrivateKeyPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Optional OpenSSH key path"
                         HorizontalAlignment="Stretch"/>
                <TextBox Header="Initial remote folder"
                         FontFamily="{StaticResource UplinkUiFont}"
                         Text="{x:Bind ViewModel.InitialRemotePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="/"
                         HorizontalAlignment="Stretch"/>
                <ComboBox Header="Folder"
                          FontFamily="{StaticResource UplinkUiFont}"
                          ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedFolder, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          PlaceholderText="(none)"
                          HorizontalAlignment="Stretch"
                          MinWidth="0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Grid.Column="2"
                    Spacing="8"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,8,0">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{StaticResource UplinkMutedTextStyle}"
                       TextWrapping="Wrap"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="New"
                        Style="{StaticResource UplinkNavButtonStyle}"
                        Command="{x:Bind ViewModel.NewSiteCommand}"
                        HorizontalAlignment="Stretch"
                        MinWidth="0"
                        Padding="8,6"/>
                <Button Grid.Column="2"
                        Content="Add"
                        Style="{StaticResource UplinkNavButtonStyle}"
                        Command="{x:Bind ViewModel.AddCommand}"
                        HorizontalAlignment="Stretch"
                        MinWidth="0"
                        Padding="8,6"/>
                <Button Grid.Column="4"
                        Content="Save"
                        Style="{StaticResource UplinkNavButtonStyle}"
                        Command="{x:Bind ViewModel.SaveCommand}"
                        HorizontalAlignment="Stretch"
                        MinWidth="0"
                        Padding="8,6"/>
                <Button Grid.Column="6"
                        Content="Delete"
                        Style="{StaticResource UplinkNavButtonStyle}"
                        Command="{x:Bind ViewModel.DeleteCommand}"
                        HorizontalAlignment="Stretch"
                        MinWidth="0"
                        Padding="8,6"/>
            </Grid>
            <Button Content="Connect"
                    Style="{StaticResource UplinkAccentButtonStyle}"
                    FontFamily="{StaticResource UplinkUiFont}"
                    Command="{x:Bind ViewModel.ConnectCommand}"
                    HorizontalAlignment="Stretch"
                    MinWidth="0"
                    Padding="12,8"
                    CornerRadius="10"/>
        </StackPanel>
    </Grid>
</ContentDialog>

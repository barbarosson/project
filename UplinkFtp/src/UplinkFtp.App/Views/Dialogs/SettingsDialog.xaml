<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="UplinkFtp.Views.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings"
    PrimaryButtonText="Close"
    DefaultButton="Primary"
    MinWidth="520"
    FontFamily="{StaticResource UplinkUiFont}">

    <!-- Keyboard: Tab cycles fields; Enter activates Save when focused on that button.
         Narrator: Headers on inputs provide accessible names; status line announces results. -->
    <ScrollViewer MaxHeight="560"
                  VerticalScrollBarVisibility="Visible"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" MinWidth="460" Padding="0,4,0,0">
            <TextBlock Text="Connection" Style="{StaticResource UplinkDialogTitleStyle}"/>
            <NumberBox Header="Connect timeout (seconds)"
                       FontFamily="{StaticResource UplinkUiFont}"
                       Value="{x:Bind ViewModel.ConnectTimeoutSeconds, Mode=TwoWay}"
                       Minimum="1"
                       Maximum="600"
                       SpinButtonPlacementMode="Inline"/>
            <NumberBox Header="Read timeout (seconds)"
                       FontFamily="{StaticResource UplinkUiFont}"
                       Value="{x:Bind ViewModel.ReadTimeoutSeconds, Mode=TwoWay}"
                       Minimum="1"
                       Maximum="3600"
                       SpinButtonPlacementMode="Inline"/>
            <NumberBox Header="Retry count"
                       FontFamily="{StaticResource UplinkUiFont}"
                       Value="{x:Bind ViewModel.RetryCount, Mode=TwoWay}"
                       Minimum="0"
                       Maximum="20"
                       SpinButtonPlacementMode="Inline"/>
            <NumberBox Header="Retry delay (seconds)"
                       FontFamily="{StaticResource UplinkUiFont}"
                       Value="{x:Bind ViewModel.RetryDelaySeconds, Mode=TwoWay}"
                       Minimum="0"
                       Maximum="120"
                       SpinButtonPlacementMode="Inline"/>
            <CheckBox Content="Use passive mode (FTP/FTPS)"
                      FontFamily="{StaticResource UplinkUiFont}"
                      IsChecked="{x:Bind ViewModel.UsePassive, Mode=TwoWay}"/>
            <CheckBox Content="Accept any FTPS certificate"
                      FontFamily="{StaticResource UplinkUiFont}"
                      IsChecked="{x:Bind ViewModel.AcceptAnyCertificate, Mode=TwoWay}"
                      ToolTipService.ToolTip="Unsafe for production — only for self-signed lab servers."/>

            <TextBlock Text="Appearance"
                       Style="{StaticResource UplinkDialogTitleStyle}"
                       Margin="0,8,0,0"/>
            <TextBlock Text="Tap a theme to preview on the shell. Save keeps it; Close reverts."
                       Style="{StaticResource UplinkMutedTextStyle}"
                       TextWrapping="Wrap"/>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Padding="6,8"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.PreviewThemeCommand}"
                        CommandParameter="Orbit"
                        ToolTipService.ToolTip="Orbit — follows your system light/dark">
                    <StackPanel Spacing="4">
                        <Border Height="28" CornerRadius="4" Background="#EEF4F6" BorderBrush="#0F766E" BorderThickness="0,0,0,4"/>
                        <TextBlock Text="Orbit" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="System" FontSize="10" Opacity="0.75" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1"
                        Padding="6,8"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.PreviewThemeCommand}"
                        CommandParameter="Daybreak"
                        ToolTipService.ToolTip="Daybreak — clear morning light">
                    <StackPanel Spacing="4">
                        <Border Height="28" CornerRadius="4" Background="#EEF4F6" BorderBrush="#0F766E" BorderThickness="0,0,0,4"/>
                        <TextBlock Text="Daybreak" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="Light" FontSize="10" Opacity="0.75" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2"
                        Padding="6,8"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.PreviewThemeCommand}"
                        CommandParameter="Nightwatch"
                        ToolTipService.ToolTip="Nightwatch — late ops dark">
                    <StackPanel Spacing="4">
                        <Border Height="28" CornerRadius="4" Background="#0B1418" BorderBrush="#2DD4BF" BorderThickness="0,0,0,4"/>
                        <TextBlock Text="Nightwatch" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="Dark" FontSize="10" Opacity="0.75" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Padding="6,8"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.PreviewThemeCommand}"
                        CommandParameter="Harbor"
                        ToolTipService.ToolTip="Harbor — cooler dockside light">
                    <StackPanel Spacing="4">
                        <Border Height="28" CornerRadius="4" Background="#E8F0F4" BorderBrush="#0B6E7A" BorderThickness="0,0,0,4"/>
                        <TextBlock Text="Harbor" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="Light" FontSize="10" Opacity="0.75" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="4"
                        Padding="6,8"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.PreviewThemeCommand}"
                        CommandParameter="Forge"
                        ToolTipService.ToolTip="Forge — charcoal workshop dark">
                    <StackPanel Spacing="4">
                        <Border Height="28" CornerRadius="4" Background="#120F0C" BorderBrush="#E8A06A" BorderThickness="0,0,0,4"/>
                        <TextBlock Text="Forge" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="Dark" FontSize="10" Opacity="0.75" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
            <ComboBox Header="Theme"
                      FontFamily="{StaticResource UplinkUiFont}"
                      ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                      SelectedItem="{x:Bind ViewModel.Theme, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"/>
            <TextBlock Text="{x:Bind ViewModel.ThemePreviewHint, Mode=OneWay}"
                       Style="{StaticResource UplinkMutedTextStyle}"
                       TextWrapping="Wrap"/>

            <TextBlock Text="Defaults"
                       Style="{StaticResource UplinkDialogTitleStyle}"
                       Margin="0,8,0,0"/>
            <ComboBox Header="Default protocol"
                      FontFamily="{StaticResource UplinkUiFont}"
                      ItemsSource="{x:Bind ViewModel.ProtocolOptions}"
                      SelectedItem="{x:Bind ViewModel.DefaultProtocol, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"/>

            <TextBlock Text="Privacy"
                       Style="{StaticResource UplinkDialogTitleStyle}"
                       Margin="0,8,0,0"/>
            <CheckBox Content="Telemetry opt-in"
                      FontFamily="{StaticResource UplinkUiFont}"
                      IsChecked="{x:Bind ViewModel.TelemetryOptIn, Mode=TwoWay}"
                      ToolTipService.ToolTip="Off by default. Never sends passwords or license keys."/>

            <TextBlock Text="AI (BYOK)"
                       Style="{StaticResource UplinkDialogTitleStyle}"
                       Margin="0,8,0,0"/>
            <TextBlock Style="{StaticResource UplinkMutedTextStyle}"
                       TextWrapping="Wrap"
                       Text="No API key is embedded. Paste a Gemini, OpenAI, or Anthropic key — stored in Windows Credential Locker only. Without a key, Assist uses on-device heuristics. Gemini default model: gemini-2.0-flash."/>
            <ComboBox Header="Provider"
                      FontFamily="{StaticResource UplinkUiFont}"
                      ItemsSource="{x:Bind ViewModel.AiProviderOptions}"
                      SelectedItem="{x:Bind ViewModel.AiProvider, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"/>
            <PasswordBox x:Name="AiKeyBox"
                         Header="API key"
                         FontFamily="{StaticResource UplinkUiFont}"
                         PlaceholderText="{x:Bind ViewModel.AiKeyPlaceholder, Mode=OneWay}"
                         PasswordChanged="AiKeyBox_PasswordChanged"/>
            <TextBox Header="Model (optional)"
                     FontFamily="{StaticResource UplinkUiFont}"
                     Text="{x:Bind ViewModel.AiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{x:Bind ViewModel.AiModelPlaceholder, Mode=OneWay}"/>
            <TextBox Header="Endpoint override (optional)"
                     FontFamily="{StaticResource UplinkUiFont}"
                     Text="{x:Bind ViewModel.AiEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{x:Bind ViewModel.AiEndpointPlaceholder, Mode=OneWay}"/>
            <CheckBox Content="Clear stored AI API key on Save"
                      FontFamily="{StaticResource UplinkUiFont}"
                      IsChecked="{x:Bind ViewModel.ClearAiApiKey, Mode=TwoWay}"/>
            <TextBlock Style="{StaticResource UplinkMutedTextStyle}"
                       Text="{x:Bind ViewModel.AiKeyStatusText, Mode=OneWay}"
                       TextWrapping="Wrap"/>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{StaticResource UplinkMutedTextStyle}"
                       TextWrapping="Wrap"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Save"
                        Style="{StaticResource AccentButtonStyle}"
                        FontFamily="{StaticResource UplinkUiFont}"
                        Command="{x:Bind ViewModel.SaveCommand}"
                        HorizontalAlignment="Stretch"
                        MinWidth="0"
                        CornerRadius="10"/>
                <Button Grid.Column="2"
                        Content="Export logs"
                        Style="{StaticResource UplinkNavButtonStyle}"
                        Command="{x:Bind ViewModel.ExportLogsCommand}"
                        HorizontalAlignment="Stretch"
                        MinWidth="0"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="UplinkFtp.Views.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings"
    PrimaryButtonText="Close"
    DefaultButton="Primary"
    FontFamily="{StaticResource UplinkUiFont}">

    <!-- Match Sites dialog width tokens so captions are not clipped at ~548px. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">560</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <!-- Keyboard: Tab cycles fields; Enter activates Save when focused on that button.
         Narrator: Headers on inputs provide accessible names; status line announces results. -->
    <!-- HorizontalScrollMode Disabled forces a finite width so TextWrapping works inside StackPanel. -->
    <ScrollViewer x:Name="SettingsScroll"
                  MaxHeight="560"
                  HorizontalAlignment="Stretch"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled"
                  VerticalScrollMode="Enabled"
                  SizeChanged="SettingsScroll_SizeChanged">
        <StackPanel x:Name="SettingsPanel"
                    Spacing="12"
                    Padding="0,4,12,0"
                    HorizontalAlignment="Stretch">
            <TextBlock Text="Connection" Style="{StaticResource UplinkDialogTitleStyle}"/>
            <NumberBox Header="Connect timeout (seconds)"
                       FontFamily="{StaticResource UplinkUiFont}"
                       Value="{x:Bind ViewModel.ConnectTimeoutSeconds, Mode=TwoWay}"
                       Minimum="1"
                       Maximum="600"
                       SpinButtonPlacementMode="Inline"/>
            <NumberBox Header="Read timeout (seconds)"
                       FontFamily="{StaticResource UplinkUiFont}"
                       Value="{x:Bind ViewModel.ReadTimeoutSeconds, Mode=TwoWay}"
                       Minimum="1"
                       Maximum="3600"
                       SpinButtonPlacementMode="Inline"/>
            <NumberBox Header="Retry count"
                       FontFamily="{StaticResource UplinkUiFont}"
                       Value="{x:Bind ViewModel.RetryCount, Mode=TwoWay}"
                       Minimum="0"
                       Maximum="20"
                       SpinButtonPlacementMode="Inline"/>
            <NumberBox Header="Retry delay (seconds)"
                       FontFamily="{StaticResource UplinkUiFont}"
                       Value="{x:Bind ViewModel.RetryDelaySeconds, Mode=TwoWay}"
                       Minimum="0"
                       Maximum="120"
                       SpinButtonPlacementMode="Inline"/>
            <CheckBox Content="Use passive mode (FTP/FTPS)"
                      FontFamily="{StaticResource UplinkUiFont}"
                      IsChecked="{x:Bind ViewModel.UsePassive, Mode=TwoWay}"/>
            <CheckBox Content="Accept any FTPS certificate"
                      FontFamily="{StaticResource UplinkUiFont}"
                      IsChecked="{x:Bind ViewModel.AcceptAnyCertificate, Mode=TwoWay}"
                      ToolTipService.ToolTip="Unsafe for production — only for self-signed lab servers."/>

            <TextBlock Text="Appearance"
                       Style="{StaticResource UplinkDialogTitleStyle}"
                       Margin="0,8,0,0"/>
            <TextBlock x:Name="ThemeIntroText"
                       Text="Tap a theme card to preview on the shell. Save keeps it; Close reverts."
                       Style="{StaticResource UplinkMutedTextStyle}"
                       TextWrapping="WrapWholeWords"
                       HorizontalAlignment="Stretch"/>
            <Grid ColumnSpacing="6" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Padding="4,8"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.PreviewThemeCommand}"
                        CommandParameter="Orbit"
                        ToolTipService.ToolTip="Orbit — follows your system light/dark">
                    <StackPanel Spacing="4">
                        <Border Height="28" CornerRadius="4" Background="#EEF4F6" BorderBrush="#0F766E" BorderThickness="0,0,0,4"/>
                        <TextBlock Text="Orbit" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="System" FontSize="10" Opacity="0.75" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1"
                        Padding="4,8"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.PreviewThemeCommand}"
                        CommandParameter="Orange"
                        ToolTipService.ToolTip="Orange — orange accent on near-black">
                    <StackPanel Spacing="4">
                        <Border Height="28" CornerRadius="4" Background="#1A1410" BorderBrush="#F97316" BorderThickness="0,0,0,4"/>
                        <TextBlock Text="Orange" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Dark" FontSize="10" Opacity="0.75" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2"
                        Padding="4,8"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.PreviewThemeCommand}"
                        CommandParameter="Red Night"
                        ToolTipService.ToolTip="Red Night — crimson on deep black-red">
                    <StackPanel Spacing="4">
                        <Border Height="28" CornerRadius="4" Background="#160A0E" BorderBrush="#EF4444" BorderThickness="0,0,0,4"/>
                        <TextBlock Text="Red Night" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Dark" FontSize="10" Opacity="0.75" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Padding="4,8"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.PreviewThemeCommand}"
                        CommandParameter="Sun Rise"
                        ToolTipService.ToolTip="Sun Rise — soft yellow and sky blue">
                    <StackPanel Spacing="4">
                        <Border Height="28" CornerRadius="4" Background="#FFF6E0" BorderBrush="#0284C7" BorderThickness="0,0,0,4"/>
                        <TextBlock Text="Sun Rise" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Light" FontSize="10" Opacity="0.75" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="4"
                        Padding="4,8"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.PreviewThemeCommand}"
                        CommandParameter="ZEN"
                        ToolTipService.ToolTip="ZEN — calm near-black and off-white">
                    <StackPanel Spacing="4">
                        <Border Height="28" CornerRadius="4" Background="#171717" BorderBrush="#E4E4E7" BorderThickness="0,0,0,4"/>
                        <TextBlock Text="ZEN" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Mono" FontSize="10" Opacity="0.75" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
            <ComboBox Header="Theme"
                      FontFamily="{StaticResource UplinkUiFont}"
                      ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                      SelectedItem="{x:Bind ViewModel.Theme, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"/>
            <TextBlock x:Name="ThemeHintText"
                       Text="{x:Bind ViewModel.ThemePreviewHint, Mode=OneWay}"
                       Style="{StaticResource UplinkMutedTextStyle}"
                       TextWrapping="WrapWholeWords"
                       HorizontalAlignment="Stretch"/>
            <TextBlock x:Name="ThemeHelpText"
                       Text="Orbit follows the system. Orange is orange on near-black. Red Night is crimson on deep black-red. Sun Rise softens yellow with sky blue. ZEN is calm near-black and off-white."
                       Style="{StaticResource UplinkMutedTextStyle}"
                       TextWrapping="WrapWholeWords"
                       HorizontalAlignment="Stretch"/>

            <TextBlock Text="Defaults"
                       Style="{StaticResource UplinkDialogTitleStyle}"
                       Margin="0,8,0,0"/>
            <ComboBox Header="Default protocol"
                      FontFamily="{StaticResource UplinkUiFont}"
                      ItemsSource="{x:Bind ViewModel.ProtocolOptions}"
                      SelectedItem="{x:Bind ViewModel.DefaultProtocol, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"/>

            <TextBlock Text="Privacy"
                       Style="{StaticResource UplinkDialogTitleStyle}"
                       Margin="0,8,0,0"/>
            <CheckBox Content="Telemetry opt-in"
                      FontFamily="{StaticResource UplinkUiFont}"
                      IsChecked="{x:Bind ViewModel.TelemetryOptIn, Mode=TwoWay}"
                      ToolTipService.ToolTip="Off by default. Never sends passwords or license keys."/>

            <TextBlock Text="AI (BYOK)"
                       Style="{StaticResource UplinkDialogTitleStyle}"
                       Margin="0,8,0,0"/>
            <TextBlock x:Name="AiBlurbText"
                       Style="{StaticResource UplinkMutedTextStyle}"
                       TextWrapping="WrapWholeWords"
                       HorizontalAlignment="Stretch"
                       Text="No API key is embedded. Paste a Gemini, OpenAI, or Anthropic key — stored in Windows Credential Locker only. Without a key, Assist uses on-device heuristics. Gemini default model: gemini-2.0-flash."/>
            <ComboBox Header="Provider"
                      FontFamily="{StaticResource UplinkUiFont}"
                      ItemsSource="{x:Bind ViewModel.AiProviderOptions}"
                      SelectedItem="{x:Bind ViewModel.AiProvider, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"/>
            <PasswordBox x:Name="AiKeyBox"
                         Header="API key"
                         FontFamily="{StaticResource UplinkUiFont}"
                         PlaceholderText="{x:Bind ViewModel.AiKeyPlaceholder, Mode=OneWay}"
                         PasswordChanged="AiKeyBox_PasswordChanged"/>
            <TextBox Header="Model (optional)"
                     FontFamily="{StaticResource UplinkUiFont}"
                     Text="{x:Bind ViewModel.AiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{x:Bind ViewModel.AiModelPlaceholder, Mode=OneWay}"/>
            <TextBox Header="Endpoint override (optional)"
                     FontFamily="{StaticResource UplinkUiFont}"
                     Text="{x:Bind ViewModel.AiEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{x:Bind ViewModel.AiEndpointPlaceholder, Mode=OneWay}"/>
            <CheckBox Content="Clear stored AI API key on Save"
                      FontFamily="{StaticResource UplinkUiFont}"
                      IsChecked="{x:Bind ViewModel.ClearAiApiKey, Mode=TwoWay}"/>
            <TextBlock x:Name="AiKeyStatusText"
                       Style="{StaticResource UplinkMutedTextStyle}"
                       Text="{x:Bind ViewModel.AiKeyStatusText, Mode=OneWay}"
                       TextWrapping="WrapWholeWords"
                       HorizontalAlignment="Stretch"/>

            <TextBlock x:Name="StatusText"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{StaticResource UplinkMutedTextStyle}"
                       TextWrapping="WrapWholeWords"
                       HorizontalAlignment="Stretch"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Save"
                        Style="{StaticResource AccentButtonStyle}"
                        FontFamily="{StaticResource UplinkUiFont}"
                        Command="{x:Bind ViewModel.SaveCommand}"
                        HorizontalAlignment="Stretch"
                        MinWidth="0"
                        CornerRadius="10"/>
                <Button Grid.Column="2"
                        Content="Export logs"
                        Style="{StaticResource UplinkNavButtonStyle}"
                        Command="{x:Bind ViewModel.ExportLogsCommand}"
                        HorizontalAlignment="Stretch"
                        MinWidth="0"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

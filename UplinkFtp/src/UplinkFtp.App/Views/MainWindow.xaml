<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="UplinkFtp.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:panels="using:UplinkFtp.Views.Panels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Uplink FTP">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Quick connect / toolbar -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Uplink FTP"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               Opacity="0.7"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Header="Host"
                             Text="{x:Bind ViewModel.Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="ftp.example.com"
                             Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1"
                             Header="Port"
                             Text="{x:Bind ViewModel.PortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="2"
                              Header="Protocol"
                              ItemsSource="{x:Bind ViewModel.ProtocolOptions}"
                              SelectedItem="{x:Bind ViewModel.SelectedProtocol, Mode=TwoWay}"
                              Margin="0,0,8,0"
                              HorizontalAlignment="Stretch"/>
                    <TextBox Grid.Column="3"
                             Header="User"
                             Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="anonymous"
                             Margin="0,0,8,0"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Grid.Column="4"
                                 Header="Password"
                                 PlaceholderText="Password"
                                 Margin="0,0,8,0"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                    <CheckBox Grid.Column="5"
                              Content="Trust cert"
                              IsChecked="{x:Bind ViewModel.AcceptAnyCertificate, Mode=TwoWay}"
                              VerticalAlignment="Bottom"
                              Margin="0,0,8,8"
                              ToolTipService.ToolTip="Accept any FTPS certificate (dev)"/>
                    <Button Grid.Column="6"
                            Content="Connect"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.ConnectCommand}"
                            VerticalAlignment="Bottom"
                            Margin="0,0,8,4"
                            MinWidth="96"/>
                    <Button Grid.Column="7"
                            Content="Disconnect"
                            Command="{x:Bind ViewModel.DisconnectCommand}"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,4"
                            MinWidth="96"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Message log -->
        <Border Grid.Row="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <panels:LogPanel x:Name="LogPanel"/>
        </Border>

        <!-- Local | Remote browsers -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <panels:LocalBrowserPanel x:Name="LocalPanel"/>
            </Border>
            <Border Grid.Column="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Border Grid.Column="2">
                <panels:RemoteBrowserPanel x:Name="RemotePanel"/>
            </Border>
        </Grid>

        <!-- Transfer queue placeholder -->
        <Border Grid.Row="3"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <panels:TransferQueuePanel x:Name="QueuePanel"/>
        </Border>

        <Border Grid.Row="4"
                Padding="12,6"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock FontSize="12" Opacity="0.65">
                <Run Text="Tip: drag local → remote to upload, remote → local to download. Transfers go through the queue (pause restarts on resume)."/>
            </TextBlock>
        </Border>
    </Grid>
</Window>

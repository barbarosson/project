<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="UplinkFtp.Views.Panels.TransferQueuePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:UplinkFtp.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Transfer queue"
                           Style="{StaticResource UplinkSectionTitleStyle}"
                           Margin="0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SummaryText}"
                           Style="{StaticResource UplinkMutedTextStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <!-- Two equal rows so Pause…Clear never clip on narrower windows -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Pause" Style="{StaticResource UplinkNavButtonStyle}"
                        Command="{Binding PauseSelectedCommand}" HorizontalAlignment="Stretch" MinWidth="0" Padding="8,6"/>
                <Button Grid.Column="2" Content="Resume" Style="{StaticResource UplinkNavButtonStyle}"
                        Command="{Binding ResumeSelectedCommand}" HorizontalAlignment="Stretch" MinWidth="0" Padding="8,6"/>
                <Button Grid.Column="4" Content="Cancel" Style="{StaticResource UplinkNavButtonStyle}"
                        Command="{Binding CancelSelectedCommand}" HorizontalAlignment="Stretch" MinWidth="0" Padding="8,6"/>
                <Button Grid.Column="6" Content="Retry" Style="{StaticResource UplinkNavButtonStyle}"
                        Command="{Binding RetrySelectedCommand}" HorizontalAlignment="Stretch" MinWidth="0" Padding="8,6"/>
                <Button Grid.Column="8" Content="Clear done" Style="{StaticResource UplinkNavButtonStyle}"
                        Command="{Binding ClearSuccessfulCommand}" HorizontalAlignment="Stretch" MinWidth="0" Padding="8,6"/>
                <Button Grid.Column="10" Content="Clear failed" Style="{StaticResource UplinkNavButtonStyle}"
                        Command="{Binding ClearFailedCommand}" HorizontalAlignment="Stretch" MinWidth="0" Padding="8,6"/>
            </Grid>
        </StackPanel>

        <TabView Grid.Row="1"
                  IsAddTabButtonVisible="False"
                  SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabView.TabItems>
                <TabViewItem Header="Queued" IsClosable="False">
                    <ListView ItemsSource="{Binding QueuedItems}"
                              SelectedItem="{Binding SelectedQueued, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TransferQueueItemViewModel">
                                <Grid Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Direction, Mode=OneWay}"
                                               Style="{StaticResource UplinkBodyTextStyle}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind DisplayName, Mode=OneWay}"
                                               Style="{StaticResource UplinkBodyTextStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Detail, Mode=OneWay}"
                                                   Style="{StaticResource UplinkMutedTextStyle}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar Minimum="0"
                                                     Maximum="100"
                                                     Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                                     Height="6"
                                                     Foreground="{ThemeResource UplinkAccentBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind Status, Mode=OneWay}"
                                               Style="{StaticResource UplinkBodyTextStyle}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4"
                                               Text="{x:Bind Destination, Mode=OneWay}"
                                               Style="{StaticResource UplinkMutedTextStyle}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </TabViewItem>

                <TabViewItem Header="Failed" IsClosable="False">
                    <ListView ItemsSource="{Binding FailedItems}"
                              SelectedItem="{Binding SelectedFailed, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TransferQueueItemViewModel">
                                <Grid Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Direction, Mode=OneWay}" Style="{StaticResource UplinkBodyTextStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind DisplayName, Mode=OneWay}"
                                               Style="{StaticResource UplinkBodyTextStyle}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind Status, Mode=OneWay}"
                                               Foreground="{ThemeResource UplinkSignalBrush}"
                                               FontFamily="{StaticResource UplinkUiFont}"
                                               FontSize="13"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind Detail, Mode=OneWay}"
                                               Style="{StaticResource UplinkMutedTextStyle}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </TabViewItem>

                <TabViewItem Header="Successful" IsClosable="False">
                    <ListView ItemsSource="{Binding SuccessfulItems}"
                              SelectedItem="{Binding SelectedSuccessful, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TransferQueueItemViewModel">
                                <Grid Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Direction, Mode=OneWay}" Style="{StaticResource UplinkBodyTextStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind DisplayName, Mode=OneWay}"
                                               Style="{StaticResource UplinkBodyTextStyle}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind Source, Mode=OneWay}"
                                               Style="{StaticResource UplinkMutedTextStyle}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind Destination, Mode=OneWay}"
                                               Style="{StaticResource UplinkMutedTextStyle}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </TabViewItem>
            </TabView.TabItems>
        </TabView>
    </Grid>
</UserControl>

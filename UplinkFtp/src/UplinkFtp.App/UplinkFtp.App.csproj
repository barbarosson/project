<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>UplinkFtp</RootNamespace>
    <AssemblyName>UplinkFtp</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Desktop / Explorer / taskbar icon for unpackaged exe -->
    <ApplicationIcon>Assets\UplinkFtp.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <!--
      Unpackaged local/CI builds embed the Windows App SDK framework payload so users
      do not need a separate (EOL 1.6) Windows App Runtime installer.
      See: https://learn.microsoft.com/windows/apps/package-and-deploy/self-contained-deploy/deploy-self-contained-apps
    -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Allows restore of windows TFM packages on non-Windows CI; full WinUI build still requires Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Custom Program.cs entry for unpackaged WinUI — suppress XAML-generated Program/Main. -->
    <DisableXamlGeneratedMain>true</DisableXamlGeneratedMain>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!--
      Distribution channel for ILicenseService:
        Web  (default) — sideload / web license key + REST/JWT
        Store          — Microsoft Store API
      Override: dotnet build -p:UplinkDistributionChannel=Store
    -->
    <UplinkDistributionChannel Condition="'$(UplinkDistributionChannel)' == ''">Web</UplinkDistributionChannel>
    <DefineConstants Condition="'$(UplinkDistributionChannel)' == 'Store'">$(DefineConstants);UPLINK_CHANNEL_STORE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- WinUI / Windows App SDK (NuGet stable 2.5.1 as of 2026-09-16; not preview) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
  </ItemGroup>

  <!-- MVVM -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <!-- Core (protocol, queue, licensing math) — FluentFTP / SSH.NET transitively -->
  <ItemGroup>
    <ProjectReference Include="..\UplinkFtp.Core\UplinkFtp.Core.csproj" />
  </ItemGroup>

  <!-- Persistence + DPAPI credential fallback -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- DI -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <!-- Localization: Strings/**/*.resw is picked up as PRIResource by the WinUI SDK
       (EnableDefaultPriItems). Do not re-Include or NETSDK1022 duplicates fire. -->

  <!-- Unpackaged WinUI needs this for Publish -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

</Project>

<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="UplinkDisplayFont">ms-appx:///Assets/Fonts/Sora-SemiBold.ttf#Sora</FontFamily>
    <FontFamily x:Key="UplinkUiFont">ms-appx:///Assets/Fonts/Sora-Regular.ttf#Sora</FontFamily>
    <FontFamily x:Key="UplinkUiFontBold">ms-appx:///Assets/Fonts/Sora-Bold.ttf#Sora</FontFamily>
    <FontFamily x:Key="UplinkMonoFont">ms-appx:///Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>

    <Style x:Key="UplinkSectionBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource UplinkSectionFillBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource UplinkSectionStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="10,6"/>
    </Style>

    <Style x:Key="UplinkBrandTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UplinkDisplayFont}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource UplinkBrandBrush}"/>
        <Setter Property="CharacterSpacing" Value="20"/>
    </Style>

    <Style x:Key="UplinkSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UplinkDisplayFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource UplinkBodyTextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="UplinkMutedTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UplinkUiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource UplinkMutedTextBrush}"/>
    </Style>

    <Style x:Key="UplinkBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UplinkUiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{ThemeResource UplinkBodyTextBrush}"/>
    </Style>

    <Style x:Key="UplinkMonoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UplinkMonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource UplinkBodyTextBrush}"/>
    </Style>

    <Style x:Key="UplinkNavButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource UplinkUiFont}"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="MinWidth" Value="78"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- Uses UplinkAccentBrush so named themes (not system teal) drive primary CTAs. -->
    <Style x:Key="UplinkAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource UplinkUiFont}"/>
        <Setter Property="Background" Value="{ThemeResource UplinkAccentBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource UplinkAccentForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource UplinkAccentBrush}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="MinWidth" Value="78"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style x:Key="UplinkDialogTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UplinkDisplayFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource UplinkBrandBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="UplinkStatusSignalStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UplinkUiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource UplinkSignalBrush}"/>
    </Style>

    <!-- App-wide rectangular scrollbars (Settings, Sites, Assist, ListViews). -->
    <x:Double x:Key="ScrollBarSize">18</x:Double>
    <x:Double x:Key="ScrollBarVerticalThumbMinWidth">14</x:Double>
    <x:Double x:Key="ScrollBarHorizontalThumbMinHeight">14</x:Double>
    <CornerRadius x:Key="ScrollBarCornerRadius">0</CornerRadius>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource DefaultScrollBarStyle}">
        <Setter Property="MinWidth" Value="{StaticResource ScrollBarSize}"/>
        <Setter Property="MinHeight" Value="{StaticResource ScrollBarSize}"/>
        <Setter Property="CornerRadius" Value="{StaticResource ScrollBarCornerRadius}"/>
        <Setter Property="Background" Value="{ThemeResource ScrollBarBackground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ScrollBarBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="IsTabStop" Value="False"/>
    </Style>
</ResourceDictionary>

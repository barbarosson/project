<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Palette overlays for named themes. Brush keys match Colors.xaml so they
      override when merged onto the shell root. Keep body/muted contrast readable
      (near-black / off-white; avoid neon glare and washed gray-on-gray).
    -->

    <!-- Orange: orange accent on near-black. -->
    <ResourceDictionary x:Key="Orange">
        <x:String x:Key="UplinkThemePaletteId">Orange</x:String>
        <SolidColorBrush x:Key="UplinkSectionFillBrush" Color="#241C16"/>
        <SolidColorBrush x:Key="UplinkSectionStrokeBrush" Color="#4A3428"/>
        <SolidColorBrush x:Key="UplinkAccentBrush" Color="#F97316"/>
        <SolidColorBrush x:Key="UplinkAccentSoftBrush" Color="#3D2414"/>
        <SolidColorBrush x:Key="UplinkBrandBrush" Color="#FDBA74"/>
        <SolidColorBrush x:Key="UplinkSignalBrush" Color="#FB923C"/>
        <SolidColorBrush x:Key="UplinkMutedTextBrush" Color="#C9B2A0"/>
        <SolidColorBrush x:Key="UplinkBodyTextBrush" Color="#F7EFE7"/>
        <SolidColorBrush x:Key="UplinkDividerBrush" Color="#5C4030"/>
        <LinearGradientBrush x:Key="UplinkShellBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#14110E" Offset="0"/>
            <GradientStop Color="#1C1612" Offset="1"/>
        </LinearGradientBrush>
    </ResourceDictionary>

    <!-- Red Night: crimson accent on deep black-red. -->
    <ResourceDictionary x:Key="RedNight">
        <x:String x:Key="UplinkThemePaletteId">RedNight</x:String>
        <SolidColorBrush x:Key="UplinkSectionFillBrush" Color="#241418"/>
        <SolidColorBrush x:Key="UplinkSectionStrokeBrush" Color="#4A2830"/>
        <SolidColorBrush x:Key="UplinkAccentBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="UplinkAccentSoftBrush" Color="#3A1418"/>
        <SolidColorBrush x:Key="UplinkBrandBrush" Color="#FCA5A5"/>
        <SolidColorBrush x:Key="UplinkSignalBrush" Color="#F87171"/>
        <SolidColorBrush x:Key="UplinkMutedTextBrush" Color="#C9A8AE"/>
        <SolidColorBrush x:Key="UplinkBodyTextBrush" Color="#F7EAEA"/>
        <SolidColorBrush x:Key="UplinkDividerBrush" Color="#5C3038"/>
        <LinearGradientBrush x:Key="UplinkShellBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#120A0C" Offset="0"/>
            <GradientStop Color="#1A0E12" Offset="1"/>
        </LinearGradientBrush>
    </ResourceDictionary>

    <!-- Sun Rise: soft yellow wash + sky-blue accent (light, readable). -->
    <ResourceDictionary x:Key="SunRise">
        <x:String x:Key="UplinkThemePaletteId">SunRise</x:String>
        <SolidColorBrush x:Key="UplinkSectionFillBrush" Color="#FFFCF5"/>
        <SolidColorBrush x:Key="UplinkSectionStrokeBrush" Color="#C5D6E4"/>
        <SolidColorBrush x:Key="UplinkAccentBrush" Color="#0284C7"/>
        <SolidColorBrush x:Key="UplinkAccentSoftBrush" Color="#E0F2FE"/>
        <SolidColorBrush x:Key="UplinkBrandBrush" Color="#0C4A6E"/>
        <SolidColorBrush x:Key="UplinkSignalBrush" Color="#D97706"/>
        <SolidColorBrush x:Key="UplinkMutedTextBrush" Color="#475569"/>
        <SolidColorBrush x:Key="UplinkBodyTextBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="UplinkDividerBrush" Color="#B8C9D8"/>
        <LinearGradientBrush x:Key="UplinkShellBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF6E0" Offset="0"/>
            <GradientStop Color="#E8F4FC" Offset="1"/>
        </LinearGradientBrush>
    </ResourceDictionary>

    <!-- ZEN: calm near-black / off-white mono (not harsh #000/#FFF). -->
    <ResourceDictionary x:Key="ZEN">
        <x:String x:Key="UplinkThemePaletteId">ZEN</x:String>
        <SolidColorBrush x:Key="UplinkSectionFillBrush" Color="#222222"/>
        <SolidColorBrush x:Key="UplinkSectionStrokeBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="UplinkAccentBrush" Color="#E4E4E7"/>
        <SolidColorBrush x:Key="UplinkAccentSoftBrush" Color="#2A2A2E"/>
        <SolidColorBrush x:Key="UplinkBrandBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="UplinkSignalBrush" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="UplinkMutedTextBrush" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="UplinkBodyTextBrush" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="UplinkDividerBrush" Color="#3F3F46"/>
        <LinearGradientBrush x:Key="UplinkShellBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#171717" Offset="0"/>
            <GradientStop Color="#1C1C1E" Offset="1"/>
        </LinearGradientBrush>
    </ResourceDictionary>
</ResourceDictionary>

<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Orbit (rewritten): soft cool daylight — misty sky wash, ink text, ocean-blue CTAs.
      Not harsh white, not teal/warm-tech, not the prior washed blue-gray.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Fluent system text/buttons inherit these — Pause/tabs/headers stay readable. -->
            <Color x:Key="TextFillColorPrimary">#132338</Color>
            <Color x:Key="TextFillColorSecondary">#3A4A5C</Color>
            <Color x:Key="TextFillColorTertiary">#5A6B7D</Color>
            <Color x:Key="TextFillColorDisabled">#9AA8B8</Color>

            <Color x:Key="UplinkShellTopColor">#E9F0F7</Color>
            <Color x:Key="UplinkShellBottomColor">#D9E4F0</Color>
            <Color x:Key="UplinkSectionFillColor">#F5F8FC</Color>
            <Color x:Key="UplinkSectionStrokeColor">#8494A8</Color>
            <Color x:Key="UplinkAccentColor">#2F6F9F</Color>
            <Color x:Key="UplinkAccentSoftColor">#C5DBEE</Color>
            <Color x:Key="UplinkAccentForegroundColor">#FFFFFF</Color>
            <Color x:Key="UplinkBrandColor">#132338</Color>
            <Color x:Key="UplinkSignalColor">#9A3B2F</Color>
            <Color x:Key="UplinkMutedTextColor">#3A4A5C</Color>
            <Color x:Key="UplinkBodyTextColor">#132338</Color>
            <Color x:Key="UplinkDividerColor">#9AA8B8</Color>
            <Color x:Key="UplinkScrollThumbColor">#5A6B7D</Color>
            <Color x:Key="UplinkScrollThumbHoverColor">#2F6F9F</Color>
            <Color x:Key="UplinkScrollTrackColor">#C8D4E2</Color>

            <!-- Rectangular, prominent WinUI ScrollBar (overrides Fluent overlay look). -->
            <x:Double x:Key="ScrollBarSize">18</x:Double>
            <x:Double x:Key="ScrollBarVerticalThumbMinWidth">14</x:Double>
            <x:Double x:Key="ScrollBarHorizontalThumbMinHeight">14</x:Double>
            <CornerRadius x:Key="ScrollBarCornerRadius">0</CornerRadius>
            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{StaticResource UplinkScrollThumbColor}"/>
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{StaticResource UplinkScrollThumbHoverColor}"/>
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{StaticResource UplinkBrandColor}"/>
            <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="#A0B0B8"/>
            <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="{StaticResource UplinkScrollThumbColor}"/>
            <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="{StaticResource UplinkScrollThumbColor}"/>
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="{StaticResource UplinkScrollTrackColor}"/>
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="{StaticResource UplinkScrollTrackColor}"/>
            <SolidColorBrush x:Key="ScrollBarTrackFillDisabled" Color="{StaticResource UplinkScrollTrackColor}"/>
            <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="{StaticResource UplinkSectionStrokeColor}"/>
            <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="{StaticResource UplinkSectionStrokeColor}"/>
            <SolidColorBrush x:Key="ScrollBarBackground" Color="{StaticResource UplinkScrollTrackColor}"/>
            <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="{StaticResource UplinkScrollTrackColor}"/>
            <SolidColorBrush x:Key="ScrollBarBorderBrush" Color="{StaticResource UplinkSectionStrokeColor}"/>
            <SolidColorBrush x:Key="ScrollBarBorderBrushPointerOver" Color="{StaticResource UplinkSectionStrokeColor}"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="TextFillColorPrimary">#F0F4F8</Color>
            <Color x:Key="TextFillColorSecondary">#C8D4E2</Color>
            <Color x:Key="TextFillColorTertiary">#9AA8B8</Color>
            <Color x:Key="TextFillColorDisabled">#5A6B7D</Color>

            <Color x:Key="UplinkShellTopColor">#121A24</Color>
            <Color x:Key="UplinkShellBottomColor">#1A2430</Color>
            <Color x:Key="UplinkSectionFillColor">#1C2836</Color>
            <Color x:Key="UplinkSectionStrokeColor">#4A5C70</Color>
            <Color x:Key="UplinkAccentColor">#5B9FD4</Color>
            <Color x:Key="UplinkAccentSoftColor">#243447</Color>
            <Color x:Key="UplinkAccentForegroundColor">#121A24</Color>
            <Color x:Key="UplinkBrandColor">#E9F0F7</Color>
            <Color x:Key="UplinkSignalColor">#E07A5F</Color>
            <Color x:Key="UplinkMutedTextColor">#B8C4D0</Color>
            <Color x:Key="UplinkBodyTextColor">#F0F4F8</Color>
            <Color x:Key="UplinkDividerColor">#4A5C70</Color>
            <Color x:Key="UplinkScrollThumbColor">#8494A8</Color>
            <Color x:Key="UplinkScrollThumbHoverColor">#5B9FD4</Color>
            <Color x:Key="UplinkScrollTrackColor">#1C2836</Color>

            <x:Double x:Key="ScrollBarSize">18</x:Double>
            <x:Double x:Key="ScrollBarVerticalThumbMinWidth">14</x:Double>
            <x:Double x:Key="ScrollBarHorizontalThumbMinHeight">14</x:Double>
            <CornerRadius x:Key="ScrollBarCornerRadius">0</CornerRadius>
            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{StaticResource UplinkScrollThumbColor}"/>
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{StaticResource UplinkScrollThumbHoverColor}"/>
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{StaticResource UplinkAccentColor}"/>
            <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="#4A5C66"/>
            <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="{StaticResource UplinkScrollThumbColor}"/>
            <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="{StaticResource UplinkScrollThumbColor}"/>
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="{StaticResource UplinkScrollTrackColor}"/>
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="{StaticResource UplinkScrollTrackColor}"/>
            <SolidColorBrush x:Key="ScrollBarTrackFillDisabled" Color="{StaticResource UplinkScrollTrackColor}"/>
            <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="{StaticResource UplinkSectionStrokeColor}"/>
            <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="{StaticResource UplinkSectionStrokeColor}"/>
            <SolidColorBrush x:Key="ScrollBarBackground" Color="{StaticResource UplinkScrollTrackColor}"/>
            <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="{StaticResource UplinkScrollTrackColor}"/>
            <SolidColorBrush x:Key="ScrollBarBorderBrush" Color="{StaticResource UplinkSectionStrokeColor}"/>
            <SolidColorBrush x:Key="ScrollBarBorderBrushPointerOver" Color="{StaticResource UplinkSectionStrokeColor}"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="TextFillColorPrimary">#132338</Color>
            <Color x:Key="TextFillColorSecondary">#3A4A5C</Color>
            <Color x:Key="TextFillColorTertiary">#5A6B7D</Color>
            <Color x:Key="TextFillColorDisabled">#9AA8B8</Color>

            <Color x:Key="UplinkShellTopColor">#E9F0F7</Color>
            <Color x:Key="UplinkShellBottomColor">#D9E4F0</Color>
            <Color x:Key="UplinkSectionFillColor">#F5F8FC</Color>
            <Color x:Key="UplinkSectionStrokeColor">#8494A8</Color>
            <Color x:Key="UplinkAccentColor">#2F6F9F</Color>
            <Color x:Key="UplinkAccentSoftColor">#C5DBEE</Color>
            <Color x:Key="UplinkAccentForegroundColor">#FFFFFF</Color>
            <Color x:Key="UplinkBrandColor">#132338</Color>
            <Color x:Key="UplinkSignalColor">#9A3B2F</Color>
            <Color x:Key="UplinkMutedTextColor">#3A4A5C</Color>
            <Color x:Key="UplinkBodyTextColor">#132338</Color>
            <Color x:Key="UplinkDividerColor">#9AA8B8</Color>
            <Color x:Key="UplinkScrollThumbColor">#5A6B7D</Color>
            <Color x:Key="UplinkScrollThumbHoverColor">#2F6F9F</Color>
            <Color x:Key="UplinkScrollTrackColor">#C8D4E2</Color>

            <x:Double x:Key="ScrollBarSize">18</x:Double>
            <x:Double x:Key="ScrollBarVerticalThumbMinWidth">14</x:Double>
            <x:Double x:Key="ScrollBarHorizontalThumbMinHeight">14</x:Double>
            <CornerRadius x:Key="ScrollBarCornerRadius">0</CornerRadius>
            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{StaticResource UplinkScrollThumbColor}"/>
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{StaticResource UplinkScrollThumbHoverColor}"/>
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{StaticResource UplinkBrandColor}"/>
            <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="#A0B0B8"/>
            <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="{StaticResource UplinkScrollThumbColor}"/>
            <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="{StaticResource UplinkScrollThumbColor}"/>
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="{StaticResource UplinkScrollTrackColor}"/>
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="{StaticResource UplinkScrollTrackColor}"/>
            <SolidColorBrush x:Key="ScrollBarTrackFillDisabled" Color="{StaticResource UplinkScrollTrackColor}"/>
            <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="{StaticResource UplinkSectionStrokeColor}"/>
            <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="{StaticResource UplinkSectionStrokeColor}"/>
            <SolidColorBrush x:Key="ScrollBarBackground" Color="{StaticResource UplinkScrollTrackColor}"/>
            <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="{StaticResource UplinkScrollTrackColor}"/>
            <SolidColorBrush x:Key="ScrollBarBorderBrush" Color="{StaticResource UplinkSectionStrokeColor}"/>
            <SolidColorBrush x:Key="ScrollBarBorderBrushPointerOver" Color="{StaticResource UplinkSectionStrokeColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="UplinkSectionFillBrush" Color="{ThemeResource UplinkSectionFillColor}"/>
    <SolidColorBrush x:Key="UplinkSectionStrokeBrush" Color="{ThemeResource UplinkSectionStrokeColor}"/>
    <SolidColorBrush x:Key="UplinkAccentBrush" Color="{ThemeResource UplinkAccentColor}"/>
    <SolidColorBrush x:Key="UplinkAccentSoftBrush" Color="{ThemeResource UplinkAccentSoftColor}"/>
    <SolidColorBrush x:Key="UplinkBrandBrush" Color="{ThemeResource UplinkBrandColor}"/>
    <SolidColorBrush x:Key="UplinkSignalBrush" Color="{ThemeResource UplinkSignalColor}"/>
    <SolidColorBrush x:Key="UplinkMutedTextBrush" Color="{ThemeResource UplinkMutedTextColor}"/>
    <SolidColorBrush x:Key="UplinkBodyTextBrush" Color="{ThemeResource UplinkBodyTextColor}"/>
    <SolidColorBrush x:Key="UplinkDividerBrush" Color="{ThemeResource UplinkDividerColor}"/>
    <!-- Accent CTA label (Orbit daylight = white on ocean blue); named themes overlay this brush. -->
    <SolidColorBrush x:Key="UplinkAccentForegroundBrush" Color="{ThemeResource UplinkAccentForegroundColor}"/>

    <LinearGradientBrush x:Key="UplinkShellBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{ThemeResource UplinkShellTopColor}" Offset="0"/>
        <GradientStop Color="{ThemeResource UplinkShellBottomColor}" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>

<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Warm-tech palette (teal accent + amber signal). Avoids purple/indigo and cream+terracotta tropes. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="UplinkShellTopColor">#EEF4F6</Color>
            <Color x:Key="UplinkShellBottomColor">#E2EBEF</Color>
            <Color x:Key="UplinkSectionFillColor">#FFFFFFF2</Color>
            <Color x:Key="UplinkSectionStrokeColor">#C5D4DB</Color>
            <Color x:Key="UplinkAccentColor">#0F766E</Color>
            <Color x:Key="UplinkAccentSoftColor">#CCFBF1</Color>
            <Color x:Key="UplinkBrandColor">#134E4A</Color>
            <Color x:Key="UplinkSignalColor">#C2410C</Color>
            <Color x:Key="UplinkMutedTextColor">#5B6B73</Color>
            <Color x:Key="UplinkBodyTextColor">#1C2B33</Color>
            <Color x:Key="UplinkDividerColor">#B7C7CF</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="UplinkShellTopColor">#0B1418</Color>
            <Color x:Key="UplinkShellBottomColor">#122027</Color>
            <Color x:Key="UplinkSectionFillColor">#1A2A32</Color>
            <Color x:Key="UplinkSectionStrokeColor">#2F4550</Color>
            <Color x:Key="UplinkAccentColor">#2DD4BF</Color>
            <Color x:Key="UplinkAccentSoftColor">#134E4A</Color>
            <Color x:Key="UplinkBrandColor">#99F6E4</Color>
            <Color x:Key="UplinkSignalColor">#FB923C</Color>
            <Color x:Key="UplinkMutedTextColor">#9BB0BA</Color>
            <Color x:Key="UplinkBodyTextColor">#E8F1F4</Color>
            <Color x:Key="UplinkDividerColor">#334955</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="UplinkShellTopColor">#EEF4F6</Color>
            <Color x:Key="UplinkShellBottomColor">#E2EBEF</Color>
            <Color x:Key="UplinkSectionFillColor">#FFFFFFF2</Color>
            <Color x:Key="UplinkSectionStrokeColor">#C5D4DB</Color>
            <Color x:Key="UplinkAccentColor">#0F766E</Color>
            <Color x:Key="UplinkAccentSoftColor">#CCFBF1</Color>
            <Color x:Key="UplinkBrandColor">#134E4A</Color>
            <Color x:Key="UplinkSignalColor">#C2410C</Color>
            <Color x:Key="UplinkMutedTextColor">#5B6B73</Color>
            <Color x:Key="UplinkBodyTextColor">#1C2B33</Color>
            <Color x:Key="UplinkDividerColor">#B7C7CF</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="UplinkSectionFillBrush" Color="{ThemeResource UplinkSectionFillColor}"/>
    <SolidColorBrush x:Key="UplinkSectionStrokeBrush" Color="{ThemeResource UplinkSectionStrokeColor}"/>
    <SolidColorBrush x:Key="UplinkAccentBrush" Color="{ThemeResource UplinkAccentColor}"/>
    <SolidColorBrush x:Key="UplinkAccentSoftBrush" Color="{ThemeResource UplinkAccentSoftColor}"/>
    <SolidColorBrush x:Key="UplinkBrandBrush" Color="{ThemeResource UplinkBrandColor}"/>
    <SolidColorBrush x:Key="UplinkSignalBrush" Color="{ThemeResource UplinkSignalColor}"/>
    <SolidColorBrush x:Key="UplinkMutedTextBrush" Color="{ThemeResource UplinkMutedTextColor}"/>
    <SolidColorBrush x:Key="UplinkBodyTextBrush" Color="{ThemeResource UplinkBodyTextColor}"/>
    <SolidColorBrush x:Key="UplinkDividerBrush" Color="{ThemeResource UplinkDividerColor}"/>

    <LinearGradientBrush x:Key="UplinkShellBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{ThemeResource UplinkShellTopColor}" Offset="0"/>
        <GradientStop Color="{ThemeResource UplinkShellBottomColor}" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
